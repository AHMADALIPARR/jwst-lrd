/* SPDX-License-Identifier: AGPL-3.0-only */
/* Check 06: gravitational redshift algebra.
   Static emitter/observer: 1+z = sqrt( -g_tt(r_o) ... ) per derivation: nu_e/nu_o ratio from the conserved
   E = -p.xi:  nu_obs/nu_emit = sqrt(f(r_e)/f(r_o)), so  1+z = nu_emit/nu_obs = sqrt(f(r_o)/f(r_e)),  f = 1 - rs/r. */
batchload("common.mac")$
assume(rs>0)$
ok: 0$ n: 0$
zg(re, ro) := sqrt((1 - rs/ro)/(1 - rs/re))$
/* (a) observer at infinity: 1+z = (1 - rs/re)^(-1/2); series in eps = rs/re */
s: taylor((1 - eps)^(-1/2), eps, 0, 4)$
print("  series of (1-eps)^(-1/2):", s)$
n: n+1$ if is(ratsimp(s - (1 + eps/2 + 3*eps^2/8 + 5*eps^3/16 + 35*eps^4/128)) = 0) then (ok: ok+1, print("   item",n,"ok")) else print("   item",n,"FAILED")$
/* (b) weak-field leading term equals Delta Phi / c^2 with Phi=-GM/r, rs=2GM/c^2 (G=c=1: rs=2M) */
M: rs/2$
dPhi: (-M/ro) - (-M/re)$   /* Phi(r_o) - Phi(r_e) */
zlin: ratsimp(at(diff(zg(re,ro), rs), rs=0))*rs$
print("  d(1+z)/d rs at rs=0, times rs:", zlin)$
n: n+1$ if is(ratsimp(zlin - dPhi) = 0) then (ok: ok+1, print("   item",n,"ok")) else print("   item",n,"FAILED")$
/* (c) divergence as r_e -> rs+ */
n: n+1$ if is(limit((1 - rs/re)/(1 - rs/ro), re, rs, plus) = 0) then (ok: ok+1, print("   item",n,"ok")) else print("   item",n,"FAILED")$   /* (1+z)^-2 -> 0, so z -> +infinity */
/* (d) composition: (1+z_cosmo)(1+z_grav) = 1+z_obs  =>  z_grav = (1+z_obs)/(1+z_cosmo) - 1 = dz/(1+z_cosmo) */
zobs: zc + dz$
n: n+1$ if is(ratsimp((1+zobs)/(1+zc) - 1 - dz/(1+zc)) = 0) then (ok: ok+1, print("   item",n,"ok")) else print("   item",n,"FAILED")$
/* (e) inversion: 1+z = (1 - rs/re)^(-1/2)  <=>  re/rs = 1/(1 - (1+z)^-2); small z: 1/(2z) */
rre: 1/(1 - (1+z)^(-2))$
n: n+1$ if is(ratsimp(1/(1 - 1/rre) - (1+z)^2) = 0) then (ok: ok+1, print("   item",n,"ok")) else print("   item",n,"FAILED")$   /* squared form of 1+z = (1-rs/re)^(-1/2) */
lead: taylor(1/rre, z, 0, 2)$
print("  1/(re/rs) series in z:", lead)$
n: n+1$ if is(ratsimp(ratdisrep(lead) - (2*z - 3*z^2)) = 0) then (ok: ok+1, print("   item",n,"ok")) else print("   item",n,"FAILED")$
/* (f) circular-orbit emitter for contrast: 1+z = (1 - 3 rs/(2 r))^(-1/2) with observer at infinity,
       small rs/r: z ~ 3 rs/(4 r)  (gravitational + transverse Doppler, not a static emitter) */
zc2: taylor((1 - 3*eps/2)^(-1/2) - 1, eps, 0, 1)$
n: n+1$ if is(ratsimp(ratdisrep(zc2) - 3*eps/4)=0) then (ok: ok+1, print("   item",n,"ok")) else print("   item",n,"FAILED")$
report("06 gravitational-redshift algebra (7 identities)", ok, n)$
