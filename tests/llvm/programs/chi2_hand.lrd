# chi2 hand value: obs=(1,2,3) model=(0,0,0) sigma=(1,2,3) -> 1+1+1 = 3 exactly.
# $1 obs, $2 model, $3 sigma.
lrdir 1
let o : arr<f64> = load($1, "1")
let m : arr<f64> = load($2, "1")
let s : arr<f64> = load($3, "1")
let c : f64 = chi2(o, m, s)
let r : arr<f64> = residuals(o, m)
print c
print r
