# NEGATIVE TEST: chi2 called UNMASKED on a sigma with NaN/0/negative entries must still reject.
lrdir 1
let o : arr<f64> = load($1, "arbitrary")
let s : arr<f64> = load($2, "arbitrary")
let c : f64 = chi2(o, o, s)
