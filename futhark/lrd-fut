# lrd-fut: LRD-ARR-v1 command-line front end for the Futhark kernels.
# Usage: lrd-fut KERNEL ARGS...   (see futhark/ABI.md)
# Environment: LRD_FUT_BIN = compiled program (default build/lrd-c next to
# this script; build/lrd-multicore for the multicore backend).
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/lrdarr.sh"
BIN=${LRD_FUT_BIN:-$HERE/build/lrd-c}
[ -x "$BIN" ] || lrd_die "compiled program $BIN missing; run make -C futhark"

TMP=$(mktemp -d "${TMPDIR:-/tmp}/lrdfut.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

run() { # run ENTRY  (stdin = Futhark input stream) -> $TMP/out
  "$BIN" -b -e "$1" > "$TMP/out"
}

usage() { sed -n 's/^#U //p' "$0" >&2; exit 2; }
#U lrd-fut vac2air IN OUT            (IN unit Angstrom)
#U lrd-fut air2vac IN OUT            (IN unit Angstrom)
#U lrd-fut um2a IN OUT               (IN unit um)
#U lrd-fut a2um IN OUT               (IN unit Angstrom)
#U lrd-fut rest Z IN OUT | obs Z IN OUT
#U lrd-fut flam2fnu LAM SIGLAM|- FLAM SIGFLAM OUT  -> OUT, OUT_sigma
#U lrd-fut fnu2flam LAM SIGLAM|- FNU SIGFNU OUT    -> OUT, OUT_sigma
#U lrd-fut resid DATA MODEL OUT
#U lrd-fut chi2 DATA MODEL SIGMA OUT  (OUT length 1)
#U lrd-fut gauss AMP CENTER SIGMA CONT LAM OUT
#U lrd-fut zgrid LAM FLUX SIGMA CENTERS WIDTHS FITCONT(0|1) ZGRID OUT
#U         -> OUT_chi2, OUT_best=[z,index], OUT_params=[amps...,cont]
#U lrd-fut synth N L0 L1 Z CENTERS WIDTHS AMPS CONT NOISE SEED OUT
#U         -> OUT_lam, OUT_flux, OUT_sigma (SYNTHETIC)
#U lrd-fut mk OUT UNIT V1 [V2 ...]   (decimal text -> LRD-ARR-v1)
#U lrd-fut cmp ATOL RTOL A B         (prints "ok maxabs maxratio", exit 1 if not ok)
#U lrd-fut dump A                    (prints Futhark text value)

[ $# -ge 1 ] || usage
K=$1; shift
u() { lrd_hdr_get "$1" unit; }
case "$K" in
  vac2air|air2vac|a2um)
    [ $# -eq 2 ] || usage
    lrd_require_unit "$1" Angstrom
    case $K in vac2air) E=vac_to_air; U=Angstrom;; air2vac) E=air_to_vac; U=Angstrom;;
               a2um) E=angstrom_to_um; U=um;; esac
    lrd_to_fut "$1" | run $E; lrd_from_fut "$TMP/out" "$2:$U" ;;
  um2a)
    [ $# -eq 2 ] || usage
    lrd_require_unit "$1" um
    lrd_to_fut "$1" | run um_to_angstrom; lrd_from_fut "$TMP/out" "$2:Angstrom" ;;
  rest|obs)
    [ $# -eq 3 ] || usage
    [ $K = rest ] && E=rest_frame || E=obs_frame
    { printf '%s ' "$1"; lrd_to_fut "$2"; } | run $E
    lrd_from_fut "$TMP/out" "$3:$(u "$2")" ;;
  flam2fnu|fnu2flam)
    [ $# -eq 5 ] || usage
    n=$(lrd_check "$1")
    if [ $K = flam2fnu ]; then E=flam_to_fnu; U=erg/s/cm2/Hz; else E=fnu_to_flam; U=erg/s/cm2/A; fi
    lrd_require_unit "$1" Angstrom
    { lrd_to_fut "$1"
      if [ "$2" = - ]; then lrd_zeros_fut "$n"; else lrd_require_unit "$2" Angstrom; lrd_to_fut "$2"; fi
      lrd_to_fut "$3"; lrd_to_fut "$4"; } | run $E
    lrd_from_fut "$TMP/out" "$5:$U" "$5_sigma:$U" ;;
  resid)
    [ $# -eq 3 ] || usage
    { lrd_to_fut "$1"; lrd_to_fut "$2"; } | run residuals
    lrd_from_fut "$TMP/out" "$3:$(u "$1")" ;;
  chi2)
    [ $# -eq 4 ] || usage
    { lrd_to_fut "$1"; lrd_to_fut "$2"; lrd_to_fut "$3"; } | run chi2
    lrd_from_fut "$TMP/out" "$4:1" ;;
  gauss)
    [ $# -eq 6 ] || usage
    { printf '%s %s %s %s ' "$1" "$2" "$3" "$4"; lrd_to_fut "$5"; } | run gauss_model
    lrd_from_fut "$TMP/out" "$6:arbitrary" ;;
  zgrid)
    [ $# -eq 8 ] || usage
    case "$6" in 1) FC=true;; 0) FC=false;; *) lrd_die "FITCONT must be 0 or 1";; esac
    { lrd_to_fut "$1"; lrd_to_fut "$2"; lrd_to_fut "$3"; lrd_to_fut "$4"; lrd_to_fut "$5"
      printf '%s ' "$FC"; lrd_to_fut "$7"; } | run zgrid_search
    lrd_from_fut "$TMP/out" "$8_chi2:1" "$8_best:1" "$8_params:$(u "$2")" ;;
  synth)
    [ $# -eq 11 ] || usage
    { printf '%s %s %s %s ' "$1" "$2" "$3" "$4"
      lrd_to_fut "$5"; lrd_to_fut "$6"; lrd_to_fut "$7"
      printf '%s %s %s ' "$8" "$9" "${10}"; } | run synth_spectrum
    LRD_EXTRA_HDR="note=SYNTHETIC" lrd_from_fut "$TMP/out" \
      "${11}_lam:Angstrom" "${11}_flux:arbitrary" "${11}_sigma:arbitrary" ;;
  mk)
    [ $# -ge 3 ] || usage
    o=$1; un=$2; shift 2
    printf '[%s]' "$(echo "$@" | sed 's/ /f64, /g; s/$/f64/')" | run ident
    LRD_EXTRA_HDR="note=SYNTHETIC" lrd_from_fut "$TMP/out" "$o:$un" ;;
  cmp)
    [ $# -eq 4 ] || usage
    na=$(lrd_check "$3"); nb=$(lrd_check "$4")
    [ "$na" = "$nb" ] || { echo "0 length-mismatch $na $nb"; exit 1; }
    { printf '%s %s ' "$1" "$2"; lrd_to_fut "$3"; lrd_to_fut "$4"; } | "$BIN" -e compare_arrays > "$TMP/c"
    r=$(tr -d '[],' < "$TMP/c" | sed 's/f64//g')
    echo "$r"
    case "$r" in 1.0*) exit 0;; *) exit 1;; esac ;;
  dump)
    [ $# -eq 1 ] || usage
    lrd_to_fut "$1" | "$BIN" -e ident ;;
  *) usage ;;
esac
