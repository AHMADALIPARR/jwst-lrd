interface System.Process where {
import Prelude;
exitWith 1 :: Prelude.Int -> Prelude.IO a;
getPID 0 :: Prelude.IO Prelude.Int;
sleep 1 :: Prelude.Int -> Prelude.IO ();
system 1 :: [Prelude.Char] -> Prelude.IO Prelude.Int;
hiding data Prelude.Int;
hiding data Prelude.IO a;
hiding data Prelude.Char
}