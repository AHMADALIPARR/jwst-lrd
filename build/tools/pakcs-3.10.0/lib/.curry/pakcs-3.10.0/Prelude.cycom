, ((Span (Position 121 1) (Position 121 62)), LineComment "-- | The class `Data` defines a strict equality operator `===`")
, ((Span (Position 122 1) (Position 122 60)), LineComment "--   and a non-deterministic operation `aValue` which yields")
, ((Span (Position 123 1) (Position 123 34)), LineComment "--   all values of the given type.")
, ((Span (Position 124 1) (Position 124 64)), LineComment "--   To ensure that the operator `===` always corresponds to the")
, ((Span (Position 125 1) (Position 125 70)), LineComment "--   syntactic equality of values and `aValue ` enumerates all values,")
, ((Span (Position 126 1) (Position 126 64)), LineComment "--   instances of `Data` are automatically derived and cannot be")
, ((Span (Position 127 1) (Position 127 38)), LineComment "--   defined in a valid Curry program.")
, ((Span (Position 128 1) (Position 128 63)), LineComment "--   For data types contain functional values, `Data` instances")
, ((Span (Position 129 1) (Position 129 21)), LineComment "--   are not derived.")
, ((Span (Position 130 1) (Position 130 60)), LineComment "--   Free variables occurring in a valid program have always")
, ((Span (Position 131 1) (Position 131 45)), LineComment "--   a `Data` context to ensure that possible")
, ((Span (Position 132 1) (Position 132 64)), LineComment "--   values for the type of the free variable can be enumerated.")
, ((Span (Position 133 1) (Position 133 2)), LineComment "--")
, ((Span (Position 134 1) (Position 134 65)), LineComment "--   Note that the class `Data` is different from the class `Eq`,")
, ((Span (Position 135 1) (Position 135 65)), LineComment "--   since the latter defines only an equivalence relation rather")
, ((Span (Position 136 1) (Position 136 29)), LineComment "--   than syntactic equality.")
, ((Span (Position 141 1) (Position 141 37)), LineComment "-- | The negation of strict equality.")
