[ ((Span (Position 1 1) (Position 1 80)), LineComment "--------------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 31)), LineComment "-- | Author : Bjoern Peemoeller")
, ((Span (Position 3 1) (Position 3 23)), LineComment "--   Version: July 2013")
, ((Span (Position 4 1) (Position 4 2)), LineComment "--")
, ((Span (Position 5 1) (Position 5 72)), LineComment "-- This module provides some utility functions for function application.")
, ((Span (Position 6 1) (Position 6 80)), LineComment "--------------------------------------------------------------------------------")
, ((Span (Position 10 1) (Position 10 58)), LineComment "-- | `fix f` is the least fixed point of the function `f`,")
, ((Span (Position 11 1) (Position 11 50)), LineComment "-- i.e. the least defined `x` such that `f x = x`.")
, ((Span (Position 15 1) (Position 15 68)), LineComment "-- | `on f g x y` applies the binary operation `f` to the results of")
, ((Span (Position 16 1) (Position 16 55)), LineComment "-- applying operation `g` to two arguments `x` and `y`.")
, ((Span (Position 17 1) (Position 17 59)), LineComment "-- Thus, it transforms two inputs and combines the outputs.")
, ((Span (Position 18 1) (Position 18 3)), LineComment "---")
, ((Span (Position 19 1) (Position 19 37)), LineComment "--     (*) `on` f = \\x y -> f x * f y")
, ((Span (Position 20 1) (Position 20 3)), LineComment "---")
, ((Span (Position 21 1) (Position 21 40)), LineComment "-- A typical usage of this operation is:")
, ((Span (Position 22 1) (Position 22 3)), LineComment "---")
, ((Span (Position 23 1) (Position 23 29)), LineComment "--     sortBy ((<=) `on` fst)")
]
