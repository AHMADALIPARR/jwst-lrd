[ ((Span (Position 1 1) (Position 1 77)), LineComment "-----------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 69)), LineComment "--- This simple module defines the const functor known from Haskell's")
, ((Span (Position 3 1) (Position 3 69)), LineComment "--- base libraries. It defines a wrapper around a constant value that")
, ((Span (Position 4 1) (Position 4 39)), LineComment "--- \"ignores\" functions mapped over it.")
, ((Span (Position 5 1) (Position 5 77)), LineComment "-----------------------------------------------------------------------------")
, ((Span (Position 11 1) (Position 11 70)), LineComment "--- The `Const` functor which returns a constant for any `fmap`, i.e.,")
, ((Span (Position 12 1) (Position 12 76)), LineComment "--- a wrapper around a constant value that ignores functions mapped over it.")
, ((Span (Position 13 1) (Position 13 3)), LineComment "---")
, ((Span (Position 14 1) (Position 14 12)), LineComment "--- Example:")
, ((Span (Position 15 1) (Position 15 3)), LineComment "---")
, ((Span (Position 16 1) (Position 16 43)), LineComment "---     > fmap (++ \"world\") (Const \"Hello\")")
, ((Span (Position 17 1) (Position 17 21)), LineComment "---     Const \"Hello\"")
]
