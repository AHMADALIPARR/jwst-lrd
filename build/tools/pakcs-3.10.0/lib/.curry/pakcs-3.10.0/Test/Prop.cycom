[ ((Span (Position 1 1) (Position 1 73)), LineComment "-------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 71)), LineComment "--- This module defines the interface of properties that can be checked")
, ((Span (Position 3 1) (Position 3 67)), LineComment "--- with the CurryCheck tool, an automatic property-based test tool")
, ((Span (Position 4 1) (Position 4 35)), LineComment "--- based on the EasyCheck library.")
, ((Span (Position 5 1) (Position 5 51)), LineComment "--- The ideas behind EasyCheck are described in the")
, ((Span (Position 6 1) (Position 6 69)), LineComment "--- [FLOPS 2008 paper](https://doi.org/10.1007/978-3-540-78969-7_23).")
, ((Span (Position 7 1) (Position 7 72)), LineComment "--- CurryCheck automatically tests properties defined with this library.")
, ((Span (Position 8 1) (Position 8 52)), LineComment "--- CurryCheck supports the definition of unit tests")
, ((Span (Position 9 1) (Position 9 62)), LineComment "--- (also for I/O operations) and property tests parameterized")
, ((Span (Position 10 1) (Position 10 70)), LineComment "--- over some arguments. CurryCheck is described in more detail in the")
, ((Span (Position 11 1) (Position 11 72)), LineComment "--- [LOPSTR 2016 paper](http://dx.doi.org/10.1007/978-3-319-63139-4_13).")
, ((Span (Position 12 1) (Position 12 3)), LineComment "---")
, ((Span (Position 13 1) (Position 13 67)), LineComment "--- Basically, this module is a stub clone of the EasyCheck library")
, ((Span (Position 14 1) (Position 14 71)), LineComment "--- which contains only the interface of the operations used to specify")
, ((Span (Position 15 1) (Position 15 70)), LineComment "--- properties. Hence, this library does not import any other library.")
, ((Span (Position 16 1) (Position 16 66)), LineComment "--- This supports the definition of properties in any other module")
, ((Span (Position 17 1) (Position 17 30)), LineComment "--- (execept for the prelude).")
, ((Span (Position 18 1) (Position 18 3)), LineComment "---")
, ((Span (Position 19 1) (Position 19 64)), LineComment "--- @author Sebastian Fischer (with extensions by Michael Hanus)")
, ((Span (Position 20 1) (Position 20 25)), LineComment "--- @version January 2019")
, ((Span (Position 21 1) (Position 21 73)), LineComment "-------------------------------------------------------------------------")
, ((Span (Position 25 3) (Position 25 24)), LineComment "-- test specification:")
, ((Span (Position 35 3) (Position 35 21)), LineComment "-- test annotations")
, ((Span (Position 38 3) (Position 38 23)), LineComment "-- enumerating values")
, ((Span (Position 50 1) (Position 50 73)), LineComment "-------------------------------------------------------------------------")
, ((Span (Position 51 1) (Position 51 36)), LineComment "-- Properties involving I/O actions:")
, ((Span (Position 53 1) (Position 53 67)), LineComment "--- The property `returns a x` is satisfied if the execution of the")
, ((Span (Position 54 1) (Position 54 41)), LineComment "--- I/O action `a` returns the value `x`.")
, ((Span (Position 58 1) (Position 58 73)), LineComment "--- The property `sameReturns a1 a2` is satisfied if the execution of the")
, ((Span (Position 59 1) (Position 59 54)), LineComment "--- I/O actions `a1` and `a2` return identical values.")
, ((Span (Position 63 1) (Position 63 75)), LineComment "--- The property `toError a` is satisfied if the evaluation of the argument")
, ((Span (Position 64 1) (Position 64 39)), LineComment "--- to normal form yields an exception.")
, ((Span (Position 68 1) (Position 68 67)), LineComment "--- The property `toIOError a` is satisfied if the execution of the")
, ((Span (Position 69 1) (Position 69 39)), LineComment "--- I/O action `a` causes an exception.")
, ((Span (Position 74 1) (Position 74 73)), LineComment "-------------------------------------------------------------------------")
, ((Span (Position 75 1) (Position 75 37)), LineComment "-- Standard properties to be checked:")
, ((Span (Position 77 1) (Position 77 73)), LineComment "--- The property `x -=- y` is satisfied if `x` and `y` have deterministic")
, ((Span (Position 78 1) (Position 78 26)), LineComment "--- values that are equal.")
, ((Span (Position 82 1) (Position 82 68)), LineComment "--- The property `x <~> y` is satisfied if the sets of the values of")
, ((Span (Position 83 1) (Position 83 26)), LineComment "--- `x` and `y` are equal.")
, ((Span (Position 87 1) (Position 87 78)), LineComment "--- The property `x ~> y` is satisfied if `x` evaluates to every value of `y`.")
, ((Span (Position 88 1) (Position 88 80)), LineComment "--- Thus, the set of values of `y` must be a subset of the set of values of `x`.")
, ((Span (Position 92 1) (Position 92 78)), LineComment "--- The property `x <~ y` is satisfied if `y` evaluates to every value of `x`.")
, ((Span (Position 93 1) (Position 93 80)), LineComment "--- Thus, the set of values of `x` must be a subset of the set of values of `y`.")
, ((Span (Position 97 1) (Position 97 74)), LineComment "--- The property `x <~~> y` is satisfied if the multisets of the values of")
, ((Span (Position 98 1) (Position 98 26)), LineComment "--- `x` and `y` are equal.")
, ((Span (Position 102 1) (Position 102 74)), LineComment "--- A conditional property is tested if the condition evaluates to `True`.")
, ((Span (Position 106 1) (Position 106 61)), LineComment "--- `solutionOf p` returns (non-deterministically) a solution")
, ((Span (Position 107 1) (Position 107 64)), LineComment "--- of predicate `p`. This operation is useful to test solutions")
, ((Span (Position 108 1) (Position 108 18)), LineComment "--- of predicates.")
, ((Span (Position 112 1) (Position 112 71)), LineComment "--- The property `is x p` is satisfied if `x` has a deterministic value")
, ((Span (Position 113 1) (Position 113 24)), LineComment "--- which satisfies `p`.")
, ((Span (Position 117 1) (Position 117 78)), LineComment "--- The property `isAlways x p` is satisfied if all values of `x` satisfy `p`.")
, ((Span (Position 121 1) (Position 121 69)), LineComment "--- The property `isEventually x p` is satisfied if some value of `x`")
, ((Span (Position 122 1) (Position 122 18)), LineComment "--- satisfies `p`.")
, ((Span (Position 126 1) (Position 126 75)), LineComment "--- The property `uniquely x` is satisfied if `x` has a deterministic value")
, ((Span (Position 127 1) (Position 127 18)), LineComment "--- which is true.")
, ((Span (Position 131 1) (Position 131 71)), LineComment "--- The property `always x` is satisfied if all values of `x` are true.")
, ((Span (Position 135 1) (Position 135 74)), LineComment "--- The property `eventually x` is satisfied if some value of `x` is true.")
, ((Span (Position 139 1) (Position 139 62)), LineComment "--- The property `failing x` is satisfied if `x` has no value.")
, ((Span (Position 143 1) (Position 143 75)), LineComment "--- The property `successful x` is satisfied if `x` has at least one value.")
, ((Span (Position 147 1) (Position 147 77)), LineComment "--- The property `deterministic x` is satisfied if `x` has exactly one value.")
, ((Span (Position 151 1) (Position 151 60)), LineComment "--- The property `x # n` is satisfied if `x` has `n` values.")
, ((Span (Position 155 1) (Position 155 71)), LineComment "--- The property `x #< n` is satisfied if `x` has less than `n` values.")
, ((Span (Position 159 1) (Position 159 71)), LineComment "--- The property `x #> n` is satisfied if `x` has more than `n` values.")
, ((Span (Position 163 1) (Position 163 64)), LineComment "--- The property `for x p` is satisfied if all values `y` of `x`")
, ((Span (Position 164 1) (Position 164 27)), LineComment "--- satisfy property `p y`.")
, ((Span (Position 168 1) (Position 168 78)), LineComment "--- The property `forAll xs p` is satisfied if all values `x` of the list `xs`")
, ((Span (Position 169 1) (Position 169 27)), LineComment "--- satisfy property `p x`.")
, ((Span (Position 173 1) (Position 173 69)), LineComment "--- The property `f <=> g` is satisfied if `f` and `g` are equivalent")
, ((Span (Position 174 1) (Position 174 74)), LineComment "--- operations, i.e., they can be replaced in any context without changing")
, ((Span (Position 175 1) (Position 175 25)), LineComment "--- the computed results.")
, ((Span (Position 179 1) (Position 179 73)), LineComment "-------------------------------------------------------------------------")
, ((Span (Position 180 1) (Position 180 19)), LineComment "-- Test Annotations")
, ((Span (Position 182 1) (Position 182 33)), LineComment "--- Assign a label to a property.")
, ((Span (Position 183 1) (Position 183 55)), LineComment "--- All labeled tests are counted and shown at the end.")
, ((Span (Position 187 1) (Position 187 65)), LineComment "--- Assign a label to a property if the first argument is `True`.")
, ((Span (Position 188 1) (Position 188 55)), LineComment "--- All labeled tests are counted and shown at the end.")
, ((Span (Position 189 1) (Position 189 57)), LineComment "--- Hence, this combinator can be used to classify tests:")
, ((Span (Position 190 1) (Position 190 3)), LineComment "---")
, ((Span (Position 191 1) (Position 191 71)), LineComment "---     multIsComm x y = classify (x<0 || y<0) \"Negative\" $ x*y -=- y*x")
, ((Span (Position 192 1) (Position 192 3)), LineComment "---")
, ((Span (Position 196 1) (Position 196 77)), LineComment "--- Assign the label \"trivial\" to a property if the first argument is `True`.")
, ((Span (Position 197 1) (Position 197 55)), LineComment "--- All labeled tests are counted and shown at the end.")
, ((Span (Position 201 1) (Position 201 60)), LineComment "--- Assign a label showing the given argument to a property.")
, ((Span (Position 202 1) (Position 202 55)), LineComment "--- All labeled tests are counted and shown at the end.")
, ((Span (Position 206 1) (Position 206 77)), LineComment "--- Assign a label showing a given name and the given argument to a property.")
, ((Span (Position 207 1) (Position 207 55)), LineComment "--- All labeled tests are counted and shown at the end.")
, ((Span (Position 211 1) (Position 211 73)), LineComment "-------------------------------------------------------------------------")
, ((Span (Position 212 1) (Position 212 19)), LineComment "-- Value generation")
, ((Span (Position 214 1) (Position 214 57)), LineComment "--- Computes the list of all values of the given argument")
, ((Span (Position 215 1) (Position 215 40)), LineComment "--- according to a given strategy (here:")
, ((Span (Position 216 1) (Position 216 58)), LineComment "--- randomized diagonalization of levels with flattening).")
, ((Span (Position 225 1) (Position 225 73)), LineComment "-------------------------------------------------------------------------")
]
