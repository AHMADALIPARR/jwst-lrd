[ ((Span (Position 1 1) (Position 1 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 43)), LineComment "--- Library containing *unsafe* operations.")
, ((Span (Position 3 1) (Position 3 79)), LineComment "--- These operations should be carefully used (e.g., for testing or debugging).")
, ((Span (Position 4 1) (Position 4 64)), LineComment "--- These operations should not be used in application programs!")
, ((Span (Position 5 1) (Position 5 3)), LineComment "---")
, ((Span (Position 6 1) (Position 6 44)), LineComment "--- @author Michael Hanus, Bjoern Peemoeller")
, ((Span (Position 7 1) (Position 7 23)), LineComment "--- @version April 2021")
, ((Span (Position 8 1) (Position 8 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 21 1) (Position 21 71)), LineComment "--- Performs and hides an I/O action in a computation (use with care!).")
, ((Span (Position 25 1) (Position 25 77)), LineComment "--- Prints the first argument as a side effect and behaves as identity on the")
, ((Span (Position 26 1) (Position 26 20)), LineComment "--- second argument.")
, ((Span (Position 30 1) (Position 30 56)), LineComment "--- Spawns a constraint and returns the second argument.")
, ((Span (Position 31 1) (Position 31 49)), LineComment "--- This function can be considered as defined by")
, ((Span (Position 32 1) (Position 32 34)), LineComment "--- `spawnConstraint c x | c = x`.")
, ((Span (Position 33 1) (Position 33 69)), LineComment "--- However, the evaluation of the constraint and the right-hand side")
, ((Span (Position 34 1) (Position 34 68)), LineComment "--- are performed concurrently, i.e., a suspension of the constraint")
, ((Span (Position 35 1) (Position 35 60)), LineComment "--- does not imply a blocking of the right-hand side and the")
, ((Span (Position 36 1) (Position 36 76)), LineComment "--- right-hand side might be evaluated before the constraint is successfully")
, ((Span (Position 37 1) (Position 37 11)), LineComment "--- solved.")
, ((Span (Position 38 1) (Position 38 65)), LineComment "--- Thus, a computation might return a result even if some of the")
, ((Span (Position 39 1) (Position 39 59)), LineComment "--- spawned constraints are suspended (use the PAKCS option")
, ((Span (Position 40 1) (Position 40 45)), LineComment "--- `+suspend` to show such suspended goals).")
, ((Span (Position 48 1) (Position 48 69)), LineComment "--- Tests whether the first argument evaluates to a currently unbound")
, ((Span (Position 49 1) (Position 49 30)), LineComment "--- variable (use with care!).")
, ((Span (Position 60 1) (Position 60 76)), LineComment "--- Tests whether both arguments evaluate to the identical currently unbound")
, ((Span (Position 61 1) (Position 61 30)), LineComment "--- variable (use with care!).")
, ((Span (Position 62 1) (Position 62 17)), LineComment "--- For instance,")
, ((Span (Position 63 1) (Position 63 3)), LineComment "---")
, ((Span (Position 64 1) (Position 64 53)), LineComment "---     identicalVar (id x) (fst (x,1))  where x free")
, ((Span (Position 65 1) (Position 65 3)), LineComment "---")
, ((Span (Position 66 1) (Position 66 32)), LineComment "--- evaluates to `True`, whereas")
, ((Span (Position 67 1) (Position 67 3)), LineComment "---")
, ((Span (Position 68 1) (Position 68 40)), LineComment "---     identicalVar x y  where x,y free")
, ((Span (Position 69 1) (Position 69 3)), LineComment "---")
, ((Span (Position 70 1) (Position 70 7)), LineComment "--- and")
, ((Span (Position 71 1) (Position 71 3)), LineComment "---")
, ((Span (Position 72 1) (Position 72 35)), LineComment "---     let x=1 in identicalVar x x")
, ((Span (Position 73 1) (Position 73 3)), LineComment "---")
, ((Span (Position 74 1) (Position 74 23)), LineComment "--- evaluate to `False`")
, ((Span (Position 78 1) (Position 78 53)), LineComment "--- `let x=1 in identicalVar x x` evaluate to `False`")
, ((Span (Position 86 1) (Position 86 58)), LineComment "--- Tests whether the argument evaluates to a ground value")
, ((Span (Position 87 1) (Position 87 21)), LineComment "--- (use with care!).")
, ((Span (Position 98 1) (Position 98 64)), LineComment "--- Comparison of any data terms, possibly containing variables.")
, ((Span (Position 99 1) (Position 99 67)), LineComment "--- Data constructors are compared in the order of their definition")
, ((Span (Position 100 1) (Position 100 66)), LineComment "--- in the datatype declarations and recursively in the arguments.")
, ((Span (Position 101 1) (Position 101 50)), LineComment "--- Variables are compared in some internal order.")
, ((Span (Position 109 1) (Position 109 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 110 1) (Position 110 62)), LineComment "-- Read and show operations on arbitrary terms and expressions")
, ((Span (Position 112 1) (Position 112 69)), LineComment "--- Transforms the normal form of a term into a string representation")
, ((Span (Position 113 1) (Position 113 32)), LineComment "--- in standard prefix notation.")
, ((Span (Position 114 1) (Position 114 60)), LineComment "--- Thus, showAnyTerm evaluates its argument to normal form.")
, ((Span (Position 115 1) (Position 115 68)), LineComment "--- This function is similar to the function `ReadShowTerm.showTerm`")
, ((Span (Position 116 1) (Position 116 71)), LineComment "--- but it also transforms logic variables into a string representation")
, ((Span (Position 117 1) (Position 117 64)), LineComment "--- that can be read back by `Unsafe.read(s)AnyUnqualifiedTerm`.")
, ((Span (Position 118 1) (Position 118 68)), LineComment "--- Thus, the result depends on the evaluation and binding status of")
, ((Span (Position 119 1) (Position 119 56)), LineComment "--- logic variables so that it should be used with care!")
, ((Span (Position 131 1) (Position 131 69)), LineComment "--- Transforms a string containing a term in standard prefix notation")
, ((Span (Position 132 1) (Position 132 63)), LineComment "--- without module qualifiers into the corresponding data term.")
, ((Span (Position 133 1) (Position 133 80)), LineComment "--- The string might contain logical variable encodings produced by showAnyTerm.")
, ((Span (Position 134 1) (Position 134 67)), LineComment "--- In case of a successful parse, the result is a one element list")
, ((Span (Position 135 1) (Position 135 73)), LineComment "--- containing a pair of the data term and the remaining unparsed string.")
, ((Span (Position 156 1) (Position 156 69)), LineComment "--- Transforms a string containing a term in standard prefix notation")
, ((Span (Position 157 1) (Position 157 63)), LineComment "--- without module qualifiers into the corresponding data term.")
, ((Span (Position 158 1) (Position 158 67)), LineComment "--- The string might contain logical variable encodings produced by")
, ((Span (Position 159 1) (Position 159 18)), LineComment "--- `showAnyTerm`.")
, ((Span (Position 172 1) (Position 172 55)), LineComment "--- Transforms any expression (even not in normal form)")
, ((Span (Position 173 1) (Position 173 32)), LineComment "--- into a string representation")
, ((Span (Position 174 1) (Position 174 58)), LineComment "--- in standard prefix notation without module qualifiers.")
, ((Span (Position 175 1) (Position 175 62)), LineComment "--- The result depends on the evaluation and binding status of")
, ((Span (Position 176 1) (Position 176 56)), LineComment "--- logic variables so that it should be used with care!")
]
