, ((Span (Position 55 1) (Position 55 63)), LineComment "-- | Opens a file in specified mode and returns a handle to it.")
, ((Span (Position 62 1) (Position 62 72)), LineComment "-- | Closes a file handle and flushes the buffer in case of output file.")
, ((Span (Position 69 1) (Position 69 73)), LineComment "-- | The computation `withFile path mode action` opens the file specified")
, ((Span (Position 70 1) (Position 70 75)), LineComment "-- `path` in the given `mode` and runs `action` on the obtained file handle")
, ((Span (Position 71 1) (Position 71 27)), LineComment "-- before closing the file.")
, ((Span (Position 72 1) (Position 72 70)), LineComment "-- The file will be also closed when the `action` raises an exception.")
, ((Span (Position 73 1) (Position 73 64)), LineComment "-- Therefore, `withFile` avoids open file handles in contrast to")
, ((Span (Position 74 1) (Position 74 2)), LineComment "--")
, ((Span (Position 75 1) (Position 75 59)), LineComment "--     openFile path mode >>= (\\h -> action h >>= hClose h)")
, ((Span (Position 76 1) (Position 76 2)), LineComment "--")
, ((Span (Position 77 1) (Position 77 71)), LineComment "-- For instance, reading the complete contents of a file and closing it")
, ((Span (Position 78 1) (Position 78 17)), LineComment "-- can be done by")
, ((Span (Position 79 1) (Position 79 2)), LineComment "--")
, ((Span (Position 80 1) (Position 80 48)), LineComment "--     withFile \"FILENAME\" ReadMode hGetContents")
