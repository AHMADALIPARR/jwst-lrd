, ((Span (Position 107 1) (Position 107 38)), LineComment "-- | Is standard input at end of file?")
, ((Span (Position 112 1) (Position 112 70)), LineComment "-- | Set the position of a handle to a seekable stream (e.g., a file).")
, ((Span (Position 113 1) (Position 113 46)), LineComment "--   If the second argument is `AbsoluteSeek`,")
, ((Span (Position 114 1) (Position 114 38)), LineComment "--   `SeekFromEnd`, or `RelativeSeek`,")
, ((Span (Position 115 1) (Position 115 63)), LineComment "--   the position is set relative to the beginning of the file,")
, ((Span (Position 116 1) (Position 116 70)), LineComment "--   to the end of the file, or to the current position, respectively.")
