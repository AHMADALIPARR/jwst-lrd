, ((Span (Position 84 23) (Position 84 70)), LineComment "-- ^ The mode in which the file should be opened")
, ((Span (Position 85 23) (Position 85 69)), LineComment "-- ^ The action to run with the obtained handle")
, ((Span (Position 93 1) (Position 93 68)), LineComment "-- | Flushes the buffer associated to handle in case of output file.")
