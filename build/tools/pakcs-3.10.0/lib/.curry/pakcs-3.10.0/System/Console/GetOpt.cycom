, ((Span (Position 44 1) (Position 58 2)), NestedComment "{-\nTwo rather obscure features are missing: The Bash 2.0 non-option hack\n(if you don't already know it, you probably don't want to hear about\nit...) and the recognition of long options with a single dash\n(e.g. '-help' is recognised as '--help', as long as there is no short\noption 'h').\n\nOther differences between GNU's getopt and this implementation:\n\n* To enforce a coherent description of options and arguments, there\n  are explanation fields in the option/argument descriptor.\n\n* Error messages are now more informative, but no longer POSIX\n  compliant... :-(\n-}")
, ((Span (Position 61 3) (Position 61 13)), LineComment "-- * GetOpt")
, ((Span (Position 64 4) (Position 64 16)), LineComment "-- * Examples")
, ((Span (Position 66 4) (Position 66 73)), LineComment "-- |To hopefully illuminate the role of the different data structures,")
, ((Span (Position 67 4) (Position 67 69)), LineComment "-- here are the command-line options for a (very simple) compiler,")
, ((Span (Position 68 4) (Position 68 33)), LineComment "-- done in two different ways.")
, ((Span (Position 69 4) (Position 69 59)), LineComment "-- The difference arises because the type of 'getOpt' is")
, ((Span (Position 70 4) (Position 70 61)), LineComment "-- parameterized by the type of values derived from flags.")
, ((Span (Position 72 4) (Position 72 46)), LineComment "-- ** Interpreting flags as concrete values")
, ((Span (Position 73 4) (Position 73 15)), LineComment "-- $example1")
, ((Span (Position 75 4) (Position 75 67)), LineComment "-- ** Interpreting flags as transformations of an options record")
, ((Span (Position 76 4) (Position 76 15)), LineComment "-- $example2")
, ((Span (Position 79 16) (Position 79 53)), LineComment "-- necessary to get dependencies right")
, ((Span (Position 82 1) (Position 82 69)), LineComment "--- A type to describe what to do with options following non-options.")
, ((Span (Position 84 33) (Position 84 80)), LineComment "-- ^ no option processing after first non-option")
, ((Span (Position 85 33) (Position 85 79)), LineComment "-- ^ freely intersperse options and non-options")
, ((Span (Position 86 33) (Position 86 66)), LineComment "-- ^ wrap non-options into options")
, ((Span (Position 88 1) (Position 88 46)), LineComment "--- Each `OptDescr` describes a single option.")
, ((Span (Position 89 1) (Position 89 4)), LineComment "--- ")
, ((Span (Position 90 1) (Position 90 34)), LineComment "--- The arguments to `Option` are:")
, ((Span (Position 91 1) (Position 91 4)), LineComment "--- ")
, ((Span (Position 92 1) (Position 92 37)), LineComment "--- * list of short option characters")
, ((Span (Position 93 1) (Position 93 4)), LineComment "--- ")
, ((Span (Position 94 1) (Position 94 48)), LineComment "--- * list of long option strings (without `--`)")
, ((Span (Position 95 1) (Position 95 4)), LineComment "--- ")
, ((Span (Position 96 1) (Position 96 25)), LineComment "--- * argument descriptor")
, ((Span (Position 97 1) (Position 97 4)), LineComment "--- ")
, ((Span (Position 98 1) (Position 98 36)), LineComment "--- * explanation of option for user")
, ((Span (Position 99 32) (Position 99 66)), LineComment "-- description of a single options:")
, ((Span (Position 100 33) (Position 100 69)), LineComment "--    list of short option characters")
, ((Span (Position 101 33) (Position 101 80)), LineComment "--    list of long option strings (without \"--\")")
, ((Span (Position 102 33) (Position 102 57)), LineComment "--    argument descriptor")
, ((Span (Position 103 33) (Position 103 68)), LineComment "--    explanation of option for user")
, ((Span (Position 105 1) (Position 105 67)), LineComment "-- |Describes whether an option takes an argument or not, and if so")
, ((Span (Position 106 1) (Position 106 57)), LineComment "-- how the argument is injected into a value of type @a@.")
, ((Span (Position 108 40) (Position 108 63)), LineComment "-- ^no argument expected")
, ((Span (Position 109 40) (Position 109 67)), LineComment "-- ^option requires argument")
, ((Span (Position 110 40) (Position 110 60)), LineComment "-- ^optional argument")
, ((Span (Position 112 32) (Position 112 75)), LineComment "-- kind of cmd line arg (internal use only):")
, ((Span (Position 113 32) (Position 113 43)), LineComment "-- an option")
, ((Span (Position 114 32) (Position 114 57)), LineComment "-- an un-recognized option")
, ((Span (Position 115 32) (Position 115 46)), LineComment "-- a non-option")
, ((Span (Position 116 32) (Position 116 67)), LineComment "-- end-of-options marker (i.e. \"--\")")
, ((Span (Position 117 32) (Position 117 57)), LineComment "-- something went wrong...")
, ((Span (Position 119 1) (Position 119 68)), LineComment "-- | Return a string describing the usage of a command, derived from")
, ((Span (Position 120 1) (Position 120 63)), LineComment "-- the header (first argument) and the options described by the")
, ((Span (Position 121 1) (Position 121 19)), LineComment "-- second argument.")
, ((Span (Position 122 40) (Position 122 48)), LineComment "-- header")
, ((Span (Position 123 40) (Position 123 60)), LineComment "-- option descriptors")
, ((Span (Position 124 40) (Position 124 80)), LineComment "-- nicely formatted decription of options")
, ((Span (Position 157 1) (Position 157 71)), LineComment "--- Process the command-line and return the list of values that matched")
, ((Span (Position 158 1) (Position 158 54)), LineComment "--- (and those that did not match). The arguments are:")
, ((Span (Position 159 1) (Position 159 4)), LineComment "--- ")
, ((Span (Position 160 1) (Position 160 45)), LineComment "--- * The order requirements (see 'ArgOrder')")
, ((Span (Position 161 1) (Position 161 4)), LineComment "--- ")
, ((Span (Position 162 1) (Position 162 46)), LineComment "--- * The option descriptions (see 'OptDescr')")
, ((Span (Position 163 1) (Position 163 4)), LineComment "--- ")
, ((Span (Position 164 1) (Position 164 60)), LineComment "--- * The actual command line arguments (presumably got from")
, ((Span (Position 165 1) (Position 165 36)), LineComment "---   `System.Environment.getArgs`).")
, ((Span (Position 166 1) (Position 166 4)), LineComment "--- ")
, ((Span (Position 167 1) (Position 167 72)), LineComment "--- `getOpt` returns a triple consisting of the option arguments, a list")
, ((Span (Position 168 1) (Position 168 49)), LineComment "--- of non-options, and a list of error messages.")
, ((Span (Position 169 40) (Position 169 61)), LineComment "-- non-option handling")
, ((Span (Position 170 40) (Position 170 60)), LineComment "-- option descriptors")
, ((Span (Position 171 40) (Position 171 68)), LineComment "-- the command-line arguments")
, ((Span (Position 172 40) (Position 172 78)), LineComment "-- (options,non-options,error messages)")
, ((Span (Position 176 1) (Position 176 63)), LineComment "--- This is almost the same as 'getOpt' but returns a quadruple")
, ((Span (Position 177 1) (Position 177 72)), LineComment "--- consisting of the option arguments, a list of non-options, a list of")
, ((Span (Position 178 1) (Position 178 55)), LineComment "--- unrecognized options, and a list of error messages.")
, ((Span (Position 179 47) (Position 179 68)), LineComment "-- non-option handling")
, ((Span (Position 180 47) (Position 180 67)), LineComment "-- option descriptors")
, ((Span (Position 181 47) (Position 181 75)), LineComment "-- the command-line arguments")
, ((Span (Position 182 47) (Position 182 98)), LineComment "-- (options,non-options,unrecognized,error messages)")
, ((Span (Position 198 1) (Position 198 69)), LineComment "-- take a look at the next cmd line arg and decide what to do with it")
, ((Span (Position 206 1) (Position 206 21)), LineComment "-- handle long option")
, ((Span (Position 228 1) (Position 228 22)), LineComment "-- handle short option")
, ((Span (Position 246 1) (Position 246 33)), LineComment "-- miscellaneous error formatting")
, ((Span (Position 261 1) (Position 305 2)), NestedComment "{-\n-----------------------------------------------------------------------------------------\n-- and here a small and hopefully enlightening example:\n\ndata Flag = Verbose | Version | Name String | Output String | Arg String   deriving Show\n\noptions :: [OptDescr Flag]\noptions =\n   [Option ['v']     [\"verbose\"]           (NoArg Verbose)      \"verbosely list files\",\n    Option ['V','?'] [\"version\",\"release\"] (NoArg Version)      \"show version info\",\n    Option ['o']     [\"output\"]            (OptArg out \"FILE\")  \"use FILE for dump\",\n    Option ['n']     [\"name\"]              (ReqArg Name \"USER\") \"only dump USER's files\"]\n\nout :: Maybe String -> Flag\nout Nothing  = Output \"stdout\"\nout (Just o) = Output o\n\ntest :: ArgOrder Flag -> [String] -> String\ntest order cmdline = case getOpt order options cmdline of\n                        (o,n,[]  ) -> \"options=\" ++ show o ++ \"  args=\" ++ show n ++ \"\\n\"\n                        (_,_,errs) -> concat errs ++ usageInfo header options\n   where header = \"Usage: foobar [OPTION...] files...\"\n\n-- example runs:\n-- putStr (test RequireOrder [\"foo\",\"-v\"])\n--    ==> options=[]  args=[\"foo\", \"-v\"]\n-- putStr (test Permute [\"foo\",\"-v\"])\n--    ==> options=[Verbose]  args=[\"foo\"]\n-- putStr (test (ReturnInOrder Arg) [\"foo\",\"-v\"])\n--    ==> options=[Arg \"foo\", Verbose]  args=[]\n-- putStr (test Permute [\"foo\",\"--\",\"-v\"])\n--    ==> options=[]  args=[\"foo\", \"-v\"]\n-- putStr (test Permute [\"-?o\",\"--name\",\"bar\",\"--na=baz\"])\n--    ==> options=[Version, Output \"stdout\", Name \"bar\", Name \"baz\"]  args=[]\n-- putStr (test Permute [\"--ver\",\"foo\"])\n--    ==> option `--ver' is ambiguous; could be one of:\n--          -v      --verbose             verbosely list files\n--          -V, -?  --version, --release  show version info\n--        Usage: foobar [OPTION...] files...\n--          -v        --verbose             verbosely list files\n--          -V, -?    --version, --release  show version info\n--          -o[FILE]  --output[=FILE]       use FILE for dump\n--          -n USER   --name=USER           only dump USER's files\n-----------------------------------------------------------------------------------------\n-}")
, ((Span (Position 307 1) (Position 346 2)), NestedComment "{- $example1\n\nA simple choice for the type associated with flags is to define a type\n@Flag@ as an algebraic type representing the possible flags and their\narguments:\n\n>    module Opts1 where\n>\n>    import System.Console.GetOpt\n>    import Data.Maybe ( fromMaybe )\n>\n>    data Flag\n>     = Verbose  | Version\n>     | Input String | Output String | LibDir String\n>       deriving Show\n>\n>    options :: [OptDescr Flag]\n>    options =\n>     [ Option ['v']     [\"verbose\"] (NoArg Verbose)       \"chatty output on stderr\"\n>     , Option ['V','?'] [\"version\"] (NoArg Version)       \"show version number\"\n>     , Option ['o']     [\"output\"]  (OptArg outp \"FILE\")  \"output FILE\"\n>     , Option ['c']     []          (OptArg inp  \"FILE\")  \"input FILE\"\n>     , Option ['L']     [\"libdir\"]  (ReqArg LibDir \"DIR\") \"library directory\"\n>     ]\n>\n>    inp,outp :: Maybe String -> Flag\n>    outp = Output . fromMaybe \"stdout\"\n>    inp  = Input  . fromMaybe \"stdin\"\n>\n>    compilerOpts :: [String] -> IO ([Flag], [String])\n>    compilerOpts argv =\n>       case getOpt Permute options argv of\n>          (o,n,[]  ) -> return (o,n)\n>          (_,_,errs) -> ioError (userError (concat errs ++ usageInfo header options))\n>      where header = \"Usage: ic [OPTION...] files...\"\n\nThen the rest of the program will use the constructed list of flags\nto determine it\\'s behaviour.\n\n-}")
, ((Span (Position 348 1) (Position 408 2)), NestedComment "{- $example2\n\nA different approach is to group the option values in a record of type\n@Options@, and have each flag yield a function of type\n@Options -> Options@ transforming this record.\n\n>    module Opts2 where\n>\n>    import System.Console.GetOpt\n>    import Data.Maybe ( fromMaybe )\n>\n>    data Options = Options\n>     { optVerbose     :: Bool\n>     , optShowVersion :: Bool\n>     , optOutput      :: Maybe FilePath\n>     , optInput       :: Maybe FilePath\n>     , optLibDirs     :: [FilePath]\n>     } deriving Show\n>\n>    defaultOptions    = Options\n>     { optVerbose     = False\n>     , optShowVersion = False\n>     , optOutput      = Nothing\n>     , optInput       = Nothing\n>     , optLibDirs     = []\n>     }\n>\n>    options :: [OptDescr (Options -> Options)]\n>    options =\n>     [ Option ['v']     [\"verbose\"]\n>         (NoArg (\\ opts -> opts { optVerbose = True }))\n>         \"chatty output on stderr\"\n>     , Option ['V','?'] [\"version\"]\n>         (NoArg (\\ opts -> opts { optShowVersion = True }))\n>         \"show version number\"\n>     , Option ['o']     [\"output\"]\n>         (OptArg ((\\ f opts -> opts { optOutput = Just f }) . fromMaybe \"output\")\n>                 \"FILE\")\n>         \"output FILE\"\n>     , Option ['c']     []\n>         (OptArg ((\\ f opts -> opts { optInput = Just f }) . fromMaybe \"input\")\n>                 \"FILE\")\n>         \"input FILE\"\n>     , Option ['L']     [\"libdir\"]\n>         (ReqArg (\\ d opts -> opts { optLibDirs = optLibDirs opts ++ [d] }) \"DIR\")\n>         \"library directory\"\n>     ]\n>\n>    compilerOpts :: [String] -> IO (Options, [String])\n>    compilerOpts argv =\n>       case getOpt Permute options argv of\n>          (o,n,[]  ) -> return (foldl (flip id) defaultOptions o, n)\n>          (_,_,errs) -> ioError (userError (concat errs ++ usageInfo header options))\n>      where header = \"Usage: ic [OPTION...] files...\"\n\nSimilarly, each flag could yield a monadic function transforming a record,\nof type @Options -> IO Options@ (or any other monad), allowing option\nprocessing to perform actions of the chosen monad, e.g. printing help or\nversion messages, checking that file arguments exist, etc.\n\n-}")
]
