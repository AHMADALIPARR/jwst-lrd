[ ((Span (Position 1 1) (Position 1 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 80)), LineComment "-- | Library with some useful operations on monads not contained in the prelude.")
, ((Span (Position 3 1) (Position 3 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 15 1) (Position 15 55)), LineComment "-- | This generalizes the list-based 'filter' function.")
, ((Span (Position 25 1) (Position 25 49)), LineComment "-- | Left-to-right composition of Kleisli arrows.")
, ((Span (Position 29 1) (Position 29 79)), LineComment "-- | Right-to-left composition of Kleisli arrows. @('>=>')@, with the arguments")
, ((Span (Position 30 1) (Position 30 11)), LineComment "-- flipped.")
, ((Span (Position 34 1) (Position 34 35)), LineComment "-- | Repeat an action indefinitely.")
, ((Span (Position 38 1) (Position 38 80)), LineComment "-- -----------------------------------------------------------------------------")
, ((Span (Position 39 1) (Position 39 24)), LineComment "-- Other monad functions")
, ((Span (Position 41 1) (Position 41 79)), LineComment "-- | The 'mapAndUnzipM' function maps its first argument over a list, returning")
, ((Span (Position 42 1) (Position 42 79)), LineComment "-- the result as a pair of lists. This function is mainly used with complicated")
, ((Span (Position 43 1) (Position 43 49)), LineComment "-- data structures or a state-transforming monad.")
, ((Span (Position 47 1) (Position 47 53)), LineComment "-- | The 'zipWithM' function generalizes 'zipWith' to")
, ((Span (Position 48 1) (Position 48 34)), LineComment "-- arbitrary applicative functors.")
, ((Span (Position 52 1) (Position 52 79)), LineComment "-- | 'zipWithM_' is the extension of 'zipWithM' which ignores the final result.")
, ((Span (Position 56 1) (Position 56 76)), LineComment "-- | The 'foldM' function is analogous to 'foldl', except that its result is")
, ((Span (Position 57 1) (Position 57 27)), LineComment "-- encapsulated in a monad.")
, ((Span (Position 62 1) (Position 62 43)), LineComment "-- | Like 'foldM', but discards the result.")
, ((Span (Position 66 1) (Position 66 54)), LineComment "-- | `replicateM n act` performs the action `n` times,")
, ((Span (Position 67 1) (Position 67 25)), LineComment "-- gathering the results.")
, ((Span (Position 76 1) (Position 76 48)), LineComment "-- | Like 'replicateM', but discards the result.")
, ((Span (Position 86 1) (Position 86 27)), LineComment "-- | The reverse of 'when'.")
, ((Span (Position 90 1) (Position 90 44)), LineComment "-- | Promotes a ternary function to a monad.")
, ((Span (Position 91 1) (Position 91 57)), LineComment "-- The function arguments are scanned from left to right.")
, ((Span (Position 92 1) (Position 92 2)), LineComment "--")
, ((Span (Position 93 1) (Position 93 12)), LineComment "-- Examples:")
, ((Span (Position 94 1) (Position 94 2)), LineComment "--")
, ((Span (Position 95 1) (Position 95 51)), LineComment "--     > liftM3 (\\x y z -> x+y+z) [1,2] [3,4] [5,6]")
, ((Span (Position 96 1) (Position 96 31)), LineComment "--     [9,10,10,11,10,11,11,12]")
, ((Span (Position 97 1) (Position 97 38)), LineComment "--     > liftM3 (,,) [1,2] [3,4] [5,6]")
, ((Span (Position 98 1) (Position 98 71)), LineComment "--    [(1,3,5),(1,3,6),(1,4,5),(1,4,6),(2,3,5),(2,3,6),(2,4,5),(2,4,6)]")
, ((Span (Position 106 1) (Position 106 71)), LineComment "-- | Removes one level of monadic structure, i.e. 'flattens' the monad.")
, ((Span (Position 110 1) (Position 110 42)), LineComment "-- | Ignores the result of the evaluation.")
, ((Span (Position 114 1) (Position 114 49)), LineComment "-- | `forM` is `mapM` with its arguments flipped.")
, ((Span (Position 118 1) (Position 118 51)), LineComment "-- | `forM_` is `mapM_` with its arguments flipped.")
, ((Span (Position 119 1) (Position 119 51)), LineComment "-- It is useful for writing imperative-style loops:")
, ((Span (Position 120 1) (Position 120 2)), LineComment "--")
, ((Span (Position 121 1) (Position 121 45)), LineComment "--     main = forM_ [1, 2, 3] $ \\i -> print i")
]
