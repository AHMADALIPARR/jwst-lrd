[ ((Span (Position 1 1) (Position 1 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 72)), LineComment "-- Library with operations to encapsulate search, i.e., to return all or")
, ((Span (Position 3 1) (Position 3 73)), LineComment "-- some values of an expression containing non-deterministic computations")
, ((Span (Position 4 1) (Position 4 70)), LineComment "-- in a data strcuture, as I/O operations in order to make the results")
, ((Span (Position 5 1) (Position 5 75)), LineComment "-- dependend on the external world, e.g., the schedule for non-determinism.")
, ((Span (Position 6 1) (Position 6 2)), LineComment "--")
, ((Span (Position 7 1) (Position 7 61)), LineComment "-- To encapsulate search in non-I/O computations, one can use")
, ((Span (Position 8 1) (Position 8 60)), LineComment "-- set functions (see module `Control.Search.SetFunctions`).")
, ((Span (Position 9 1) (Position 9 2)), LineComment "--")
, ((Span (Position 10 1) (Position 10 25)), LineComment "-- Author : Michael Hanus")
, ((Span (Position 11 1) (Position 11 24)), LineComment "-- Version: October 2026")
, ((Span (Position 12 1) (Position 12 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 20 1) (Position 20 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 22 1) (Position 22 72)), LineComment "-- | Gets all values of an expression (similarly to Prolog's `findall`).")
, ((Span (Position 23 1) (Position 23 67)), LineComment "-- Conceptually, the value is computed on a copy of the expression,")
, ((Span (Position 24 1) (Position 24 69)), LineComment "-- i.e., the evaluation of the expression does not share any results.")
, ((Span (Position 25 1) (Position 25 2)), LineComment "--")
, ((Span (Position 26 1) (Position 26 69)), LineComment "-- The strategy to search for all values depends on the Curry system:")
, ((Span (Position 27 1) (Position 27 2)), LineComment "--")
, ((Span (Position 28 1) (Position 28 78)), LineComment "-- * PAKCS uses a depth-first search strategy and computes all values at once,")
, ((Span (Position 29 1) (Position 29 79)), LineComment "-- * KiCS2 uses a breadth-first search strategy and computes all values lazily.")
, ((Span (Position 30 1) (Position 30 73)), LineComment "-- * Curry2Go uses a fair search strategy and computes all values lazily.")
, ((Span (Position 31 1) (Position 31 2)), LineComment "--")
, ((Span (Position 32 1) (Position 32 64)), LineComment "--   In PAKCS, the evaluation suspends as long as the expression")
, ((Span (Position 33 1) (Position 33 53)), LineComment "--   or its computed value contain unbound variables.")
, ((Span (Position 37 1) (Position 37 38)), LineComment "-- | Gets all values of an expression.")
, ((Span (Position 38 1) (Position 38 76)), LineComment "-- This operation is similar to 'getAllValues' but uses a depth-first search")
, ((Span (Position 39 1) (Position 39 27)), LineComment "-- strategy (if available).")
, ((Span (Position 40 1) (Position 40 68)), LineComment "-- Thus, it could be more efficient than 'getAllValues' but it might")
, ((Span (Position 41 1) (Position 41 73)), LineComment "-- not terminate (instead of computing of all values) if the search space")
, ((Span (Position 42 1) (Position 42 15)), LineComment "-- is infinite.")
, ((Span (Position 46 1) (Position 46 49)), LineComment "-- | Gets one value of an expression or `Nothing`")
, ((Span (Position 47 1) (Position 47 34)), LineComment "-- if the expression has no value.")
, ((Span (Position 48 1) (Position 48 67)), LineComment "-- Conceptually, the value is computed on a copy of the expression,")
, ((Span (Position 49 1) (Position 49 69)), LineComment "-- i.e., the evaluation of the expression does not share any results.")
, ((Span (Position 50 1) (Position 50 2)), LineComment "--")
, ((Span (Position 51 1) (Position 51 66)), LineComment "-- The strategy to search for a value depends on the Curry system:")
, ((Span (Position 52 1) (Position 52 2)), LineComment "--")
, ((Span (Position 53 1) (Position 53 46)), LineComment "-- * PAKCS uses a depth-first search strategy,")
, ((Span (Position 54 1) (Position 54 52)), LineComment "-- * KiCS2 uses a breadth-first search strategy, and")
, ((Span (Position 55 1) (Position 55 42)), LineComment "-- * Curry2Go uses a fair search strategy.")
, ((Span (Position 56 1) (Position 56 2)), LineComment "--")
, ((Span (Position 57 1) (Position 57 62)), LineComment "-- In PAKCS, the evaluation suspends as long as the expression")
, ((Span (Position 58 1) (Position 58 51)), LineComment "-- or its computed value contain unbound variables.")
, ((Span (Position 62 1) (Position 62 49)), LineComment "-- | Gets one value of an expression or `Nothing`")
, ((Span (Position 63 1) (Position 63 34)), LineComment "-- if the expression has no value.")
, ((Span (Position 64 1) (Position 64 75)), LineComment "-- This operation is similar to 'getOneValue' but uses a depth-first search")
, ((Span (Position 65 1) (Position 65 27)), LineComment "-- strategy (if available).")
, ((Span (Position 66 1) (Position 66 81)), LineComment "-- Thus, it could be more efficient than 'getOneValue' but it might not terminate")
, ((Span (Position 67 1) (Position 67 67)), LineComment "-- (instead of computing of value) if the search space is infinite.")
, ((Span (Position 71 1) (Position 71 69)), LineComment "-- | Returns a list of values that do not satisfy a given constraint.")
, ((Span (Position 72 1) (Position 72 38)), LineComment "-- As a simple example, the expression")
, ((Span (Position 73 1) (Position 73 2)), LineComment "--")
, ((Span (Position 74 1) (Position 74 61)), LineComment "--     getAllFailures ([] ? [1] ? [2]) (\\xs -> head xs =:= 1)")
, ((Span (Position 75 1) (Position 75 2)), LineComment "--")
, ((Span (Position 76 1) (Position 76 28)), LineComment "-- evaluates to `[[], [2]]`.")
, ((Span (Position 77 31) (Position 77 71)), LineComment "-- ^ an expression \180e\180 (e.g., a generator")
, ((Span (Position 78 31) (Position 78 63)), LineComment "--   evaluable to various values)")
, ((Span (Position 79 31) (Position 79 80)), LineComment "-- ^ a constraint \180c\180 that should not be satisfied")
, ((Span (Position 80 31) (Position 80 60)), LineComment "-- ^ list of all values of `e`")
, ((Span (Position 81 31) (Position 81 68)), LineComment "--   such that `(c e)` is not provable")
, ((Span (Position 87 1) (Position 87 58)), LineComment "-- (naf c x) returns [x] if (c x) fails, and [] otherwise.")
