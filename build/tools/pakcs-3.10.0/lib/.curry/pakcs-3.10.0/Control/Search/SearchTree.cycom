[ ((Span (Position 1 1) (Position 1 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 60)), LineComment "-- | Description: Representation of a search space as a tree")
, ((Span (Position 3 1) (Position 3 63)), LineComment "--   Author     : Michael Hanus, Bjoern Peemoeller, Fabian Reck")
, ((Span (Position 4 1) (Position 4 27)), LineComment "--   Version    : July 2026")
, ((Span (Position 5 1) (Position 5 2)), LineComment "--")
, ((Span (Position 6 1) (Position 6 61)), LineComment "-- This library defines a representation of a search space as")
, ((Span (Position 7 1) (Position 7 53)), LineComment "-- a tree and various search strategies on this tree.")
, ((Span (Position 8 1) (Position 8 70)), LineComment "-- This module implements **strong encapsulation** as discussed in the")
, ((Span (Position 9 1) (Position 9 114)), LineComment "-- [JFLP'04 paper](http://danae.uni-muenster.de/lehre/kuchen/JFLP/articles/2004/S04-01/A2004-06/JFLP-A2004-06.pdf)")
, ((Span (Position 10 1) (Position 10 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 32 1) (Position 32 79)), LineComment "-- | A search tree is a value, a failure, or a choice between two search trees.")
, ((Span (Position 37 1) (Position 37 71)), LineComment "-- | A search strategy maps a search tree into some sequence of values.")
, ((Span (Position 38 1) (Position 38 78)), LineComment "--   Using the abtract type of sequence of values (rather than list of values)")
, ((Span (Position 39 1) (Position 39 65)), LineComment "--   enables the use of search strategies for encapsulated search")
, ((Span (Position 40 1) (Position 40 56)), LineComment "--   with search trees (strong encapsulation) as well as")
, ((Span (Position 41 1) (Position 41 45)), LineComment "--   with set functions (weak encapsulation).")
, ((Span (Position 44 1) (Position 44 49)), LineComment "-- | Returns the search tree for some expression.")
, ((Span (Position 48 1) (Position 48 70)), LineComment "-- | Internal operation to return the search tree for some expression.")
, ((Span (Position 49 1) (Position 49 61)), LineComment "--   Note that this operation is not purely declarative since")
, ((Span (Position 50 1) (Position 50 61)), LineComment "--   the ordering in the resulting search tree depends on the")
, ((Span (Position 51 1) (Position 51 35)), LineComment "--   ordering of the program rules.")
, ((Span (Position 52 1) (Position 52 2)), LineComment "--")
, ((Span (Position 53 1) (Position 53 66)), LineComment "--   Note that in PAKCS the search tree is just a degenerated tree")
, ((Span (Position 54 1) (Position 54 55)), LineComment "--   representing all values of the argument expression")
, ((Span (Position 55 1) (Position 55 52)), LineComment "--   and it is computed at once (i.e., not lazily!).")
, ((Span (Position 66 1) (Position 66 65)), LineComment "-- | Returns True iff the argument is defined, i.e., has a value.")
, ((Span (Position 73 1) (Position 73 56)), LineComment "-- | Shows the search tree as an intended line structure")
, ((Span (Position 77 3) (Position 77 74)), LineComment "-- `showsST ctxt <SearchTree>`, where `ctxt` is a stack of boolean flags")
, ((Span (Position 78 3) (Position 78 70)), LineComment "-- indicating whether we show the last alternative of the respective")
, ((Span (Position 79 3) (Position 79 48)), LineComment "-- level to enable drawing aesthetical corners")
, ((Span (Position 92 19) (Position 92 33)), LineComment "-- vertical bar")
, ((Span (Position 93 19) (Position 93 35)), LineComment "-- horizontal bar")
, ((Span (Position 94 19) (Position 94 38)), LineComment "-- left lower corner")
, ((Span (Position 95 19) (Position 95 39)), LineComment "-- left middle corner")
, ((Span (Position 102 1) (Position 102 37)), LineComment "-- showSearchTree st = showST 0 st \"\"")
, ((Span (Position 103 1) (Position 103 9)), LineComment "--  where")
, ((Span (Position 104 1) (Position 104 62)), LineComment "--   showST _ (Value a)  = showString \"Value: \" . shows a . nl")
, ((Span (Position 105 1) (Position 105 52)), LineComment "--   showST _ Fail       = showString \"Fail\"    . nl")
, ((Span (Position 106 1) (Position 106 43)), LineComment "--   showST i (Or t1 t2) = showString \"Or \"")
, ((Span (Position 107 1) (Position 107 63)), LineComment "--                       . showST i' t1 . tab i' . showST i' t2")
, ((Span (Position 108 1) (Position 108 26)), LineComment "--     where i'    = i + 1")
, ((Span (Position 109 1) (Position 109 55)), LineComment "--           tab j = showString $ replicate (3 * j) ' '")
, ((Span (Position 112 1) (Position 112 73)), LineComment "-- | Returns the size (number of Value/Fail/Or nodes) of the search tree.")
, ((Span (Position 120 1) (Position 120 68)), LineComment "-- | Limit the depth of a search tree. Branches which a depth larger")
, ((Span (Position 121 1) (Position 121 56)), LineComment "--   than the first argument are replace by `Fail (-1)`.")
, ((Span (Position 129 1) (Position 129 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 130 1) (Position 130 43)), LineComment "-- Definition of various search strategies:")
, ((Span (Position 131 1) (Position 131 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 133 1) (Position 133 33)), LineComment "-- | Depth-first search strategy.")
, ((Span (Position 140 1) (Position 140 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 142 1) (Position 142 35)), LineComment "-- | Breadth-first search strategy.")
, ((Span (Position 156 1) (Position 156 64)), LineComment "-- Transforms a list of search trees into a value sequence where")
, ((Span (Position 157 1) (Position 157 23)), LineComment "-- choices are ignored.")
, ((Span (Position 165 1) (Position 165 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 167 1) (Position 167 41)), LineComment "-- | Iterative-deepening search strategy.")
, ((Span (Position 171 1) (Position 171 45)), LineComment "-- | The default initial search depth for IDS")
, ((Span (Position 175 1) (Position 175 44)), LineComment "-- | The default increasing function for IDS")
, ((Span (Position 179 1) (Position 179 55)), LineComment "-- | Parameterized iterative-deepening search strategy.")
, ((Span (Position 180 1) (Position 180 54)), LineComment "--   The first argument is the initial depth bound and")
, ((Span (Position 181 1) (Position 181 68)), LineComment "--   the second argument is a function to increase the depth in each")
, ((Span (Position 182 1) (Position 182 15)), LineComment "--   iteration.")
, ((Span (Position 193 1) (Position 193 56)), LineComment "-- Collect solutions within some level bounds in a tree.")
, ((Span (Position 203 1) (Position 203 63)), LineComment "-- List containing \"aborts\" are used to implement the iterative")
, ((Span (Position 204 1) (Position 204 22)), LineComment "-- depeening strategy:")
, ((Span (Position 208 1) (Position 208 68)), LineComment "-- Concatenation on abort lists where aborts are moved to the right.")
, ((Span (Position 219 1) (Position 219 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 220 1) (Position 220 38)), LineComment "-- Diagonalization search according to")
, ((Span (Position 221 1) (Position 221 74)), LineComment "-- J. Christiansen, S Fischer: EasyCheck - Test Data for Free (FLOPS 2008)")
, ((Span (Position 223 1) (Position 223 37)), LineComment "-- | Diagonalization search strategy.")
, ((Span (Position 227 1) (Position 227 69)), LineComment "-- Enumerate all nodes of a forest of search trees in a level manner.")
, ((Span (Position 232 1) (Position 232 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 233 1) (Position 233 54)), LineComment "-- Operations to map search trees into list of values.")
, ((Span (Position 234 1) (Position 234 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 236 1) (Position 236 71)), LineComment "-- | Return all values in a search tree via some given search strategy.")
, ((Span (Position 240 1) (Position 240 63)), LineComment "-- | Return all values in a search tree via depth-first search.")
, ((Span (Position 244 1) (Position 244 65)), LineComment "-- | Return all values in a search tree via breadth-first search.")
, ((Span (Position 248 1) (Position 248 71)), LineComment "-- | Return all values in a search tree via iterative-deepening search.")
, ((Span (Position 252 1) (Position 252 71)), LineComment "-- | Return all values in a search tree via iterative-deepening search.")
, ((Span (Position 253 1) (Position 253 54)), LineComment "--   The first argument is the initial depth bound and")
, ((Span (Position 254 1) (Position 254 68)), LineComment "--   the second argument is a function to increase the depth in each")
, ((Span (Position 255 1) (Position 255 15)), LineComment "--   iteration.")
, ((Span (Position 260 1) (Position 260 76)), LineComment "-- | Return all values in a search tree via diagonalization search strategy.")
, ((Span (Position 265 1) (Position 265 63)), LineComment "-- | Gets all values of an expression w.r.t. a search strategy.")
, ((Span (Position 266 1) (Position 266 64)), LineComment "--   A search strategy is an operation to traverse a search tree")
, ((Span (Position 267 1) (Position 267 66)), LineComment "--   and collect all values, e.g., 'dfsStrategy' or 'bfsStrategy'.")
, ((Span (Position 268 1) (Position 268 71)), LineComment "--   Conceptually, all values are computed on a copy of the expression,")
, ((Span (Position 269 1) (Position 269 71)), LineComment "--   i.e., the evaluation of the expression does not share any results.")
, ((Span (Position 276 1) (Position 276 65)), LineComment "-- | Prints all values of an expression w.r.t. a search strategy.")
, ((Span (Position 277 1) (Position 277 64)), LineComment "--   A search strategy is an operation to traverse a search tree")
, ((Span (Position 278 1) (Position 278 66)), LineComment "--   and collect all values, e.g., 'dfsStrategy' or 'bfsStrategy'.")
, ((Span (Position 279 1) (Position 279 79)), LineComment "--   Conceptually, all printed values are computed on a copy of the expression,")
, ((Span (Position 280 1) (Position 280 71)), LineComment "--   i.e., the evaluation of the expression does not share any results.")
, ((Span (Position 286 1) (Position 286 64)), LineComment "-- | Prints the values of an expression w.r.t. a search strategy")
, ((Span (Position 287 1) (Position 287 67)), LineComment "--   on demand by the user. Thus, the user must type <ENTER> before")
, ((Span (Position 288 1) (Position 288 43)), LineComment "--   another value is computed and printed.")
, ((Span (Position 289 1) (Position 289 64)), LineComment "--   A search strategy is an operation to traverse a search tree")
, ((Span (Position 290 1) (Position 290 66)), LineComment "--   and collect all values, e.g., 'dfsStrategy' or 'bfsStrategy'.")
, ((Span (Position 291 1) (Position 291 79)), LineComment "--   Conceptually, all printed values are computed on a copy of the expression,")
, ((Span (Position 292 1) (Position 292 71)), LineComment "--   i.e., the evaluation of the expression does not share any results.")
, ((Span (Position 304 1) (Position 304 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 305 1) (Position 305 42)), LineComment "-- | Returns some value for an expression.")
, ((Span (Position 306 1) (Position 306 2)), LineComment "--")
, ((Span (Position 307 1) (Position 307 61)), LineComment "--   Note that this operation is not purely declarative since")
, ((Span (Position 308 1) (Position 308 69)), LineComment "--   the computed value depends on the ordering of the program rules.")
, ((Span (Position 309 1) (Position 309 63)), LineComment "--   Thus, this operation should be used only if the expression")
, ((Span (Position 310 1) (Position 310 65)), LineComment "--   has a single value. It fails if the expression has no value.")
, ((Span (Position 314 1) (Position 314 67)), LineComment "-- | Returns some value for an expression w.r.t. a search strategy.")
, ((Span (Position 315 1) (Position 315 64)), LineComment "--   A search strategy is an operation to traverse a search tree")
, ((Span (Position 316 1) (Position 316 66)), LineComment "--   and collect all values, e.g., 'dfsStrategy' or 'bfsStrategy'.")
, ((Span (Position 317 1) (Position 317 2)), LineComment "--")
, ((Span (Position 318 1) (Position 318 61)), LineComment "--   Note that this operation is not purely declarative since")
, ((Span (Position 319 1) (Position 319 69)), LineComment "--   the computed value depends on the ordering of the program rules.")
, ((Span (Position 320 1) (Position 320 63)), LineComment "--   Thus, this operation should be used only if the expression")
, ((Span (Position 321 1) (Position 321 65)), LineComment "--   has a single value. It fails if the expression has no value.")
, ((Span (Position 325 1) (Position 325 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 326 1) (Position 326 70)), LineComment "-- The subsequent part defines a data structure for sequence of values")
, ((Span (Position 327 1) (Position 327 55)), LineComment "-- which is used in the implementation of search trees.")
, ((Span (Position 328 1) (Position 328 66)), LineComment "-- Using sequence of values (rather than standard lists of values)")
, ((Span (Position 329 1) (Position 329 52)), LineComment "-- is necessary to get the behavior of set functions")
, ((Span (Position 330 1) (Position 330 58)), LineComment "-- w.r.t. finite failures right, as described in the paper")
, ((Span (Position 331 1) (Position 331 2)), LineComment "--")
, ((Span (Position 332 1) (Position 332 51)), LineComment "-- > J. Christiansen, M. Hanus, F. Reck, D. Seidel:")
, ((Span (Position 333 1) (Position 333 76)), LineComment "-- > A Semantics for Weakly Encapsulated Search in Functional Logic Programs")
, ((Span (Position 334 1) (Position 334 67)), LineComment "-- > Proc. 15th International Conference on Principles and Practice")
, ((Span (Position 335 1) (Position 335 69)), LineComment "-- > of Declarative Programming (PPDP'13), pp. 49-60, ACM Press, 2013")
, ((Span (Position 336 1) (Position 336 2)), LineComment "--")
, ((Span (Position 337 1) (Position 337 47)), LineComment "-- Note that this is implemented only in KiCS2.")
, ((Span (Position 338 1) (Position 338 71)), LineComment "-- In other Curry implementations, it is simplified in order to provide")
, ((Span (Position 339 1) (Position 339 44)), LineComment "-- some functionality used by other modules.")
, ((Span (Position 340 1) (Position 340 68)), LineComment "-- In particular, the intended semantics of failures is not provided")
, ((Span (Position 341 1) (Position 341 28)), LineComment "-- in other implementations.")
, ((Span (Position 343 1) (Position 343 56)), LineComment "-- | A value sequence is an abstract sequence of values.")
, ((Span (Position 344 1) (Position 344 74)), LineComment "--   It also contains failure elements in order to implement the semantics")
, ((Span (Position 345 1) (Position 345 60)), LineComment "--   of set functions w.r.t. failures in the intended manner")
, ((Span (Position 346 1) (Position 346 41)), LineComment "--   (this is implemented only in KiCS2).")
, ((Span (Position 353 1) (Position 353 33)), LineComment "-- | An empty sequence of values.")
, ((Span (Position 361 1) (Position 361 42)), LineComment "-- | Adds a value to a sequence of values.")
, ((Span (Position 369 1) (Position 369 44)), LineComment "-- | Adds a failure to a sequence of values.")
, ((Span (Position 370 1) (Position 370 60)), LineComment "--   The argument is the encapsulation level of the failure.")
, ((Span (Position 375 20) (Position 375 54)), LineComment "-- cannot be implemented in PAKCS!\"")
, ((Span (Position 378 1) (Position 378 42)), LineComment "-- | Concatenates two sequences of values.")
, ((Span (Position 387 1) (Position 387 59)), LineComment "-- | Transforms a sequence of values into a list of values.")
