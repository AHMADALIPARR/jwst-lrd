[ ((Span (Position 1 1) (Position 1 72)), LineComment "------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 61)), LineComment "-- | This module contains an implementation of set functions.")
, ((Span (Position 3 1) (Position 3 2)), LineComment "--")
, ((Span (Position 4 1) (Position 4 53)), LineComment "-- The general idea of set functions is described in:")
, ((Span (Position 5 1) (Position 5 2)), LineComment "--")
, ((Span (Position 6 1) (Position 6 71)), LineComment "-- > S. Antoy, M. Hanus: Set Functions for Functional Logic Programming")
, ((Span (Position 7 1) (Position 7 67)), LineComment "-- > Proc. 11th International Conference on Principles and Practice")
, ((Span (Position 8 1) (Position 8 69)), LineComment "-- > of Declarative Programming (PPDP'09), pp. 73-82, ACM Press, 2009")
, ((Span (Position 9 1) (Position 9 2)), LineComment "--")
, ((Span (Position 10 1) (Position 10 54)), LineComment "-- The general concept of set functions is as follows.")
, ((Span (Position 11 1) (Position 11 63)), LineComment "-- If `f` is an n-ary function, then `(setn f)` is a set-valued")
, ((Span (Position 12 1) (Position 12 66)), LineComment "-- function that collects all non-determinism caused by f (but not")
, ((Span (Position 13 1) (Position 13 65)), LineComment "-- the non-determinism caused by evaluating arguments!) in a set.")
, ((Span (Position 14 1) (Position 14 52)), LineComment "-- Thus, `(setn f a1 ... an)` returns the set of all")
, ((Span (Position 15 1) (Position 15 59)), LineComment "-- values of `(f b1 ... bn)` where `b1`,...,`bn` are values")
, ((Span (Position 16 1) (Position 16 58)), LineComment "-- of the arguments `a1`,...,`an` (i.e., the arguments are")
, ((Span (Position 17 1) (Position 17 63)), LineComment "-- evaluated \"outside\" this capsule so that the non-determinism")
, ((Span (Position 18 1) (Position 18 71)), LineComment "-- caused by evaluating these arguments is not captured in this capsule")
, ((Span (Position 19 1) (Position 19 46)), LineComment "-- but yields several results for `(setn...)`.")
, ((Span (Position 20 1) (Position 20 71)), LineComment "-- Similarly, logical variables occuring in `a1`,...,`an` are not bound")
, ((Span (Position 21 1) (Position 21 62)), LineComment "-- inside this capsule (in PAKCS they cause a suspension until")
, ((Span (Position 22 1) (Position 22 19)), LineComment "-- they are bound).")
, ((Span (Position 23 1) (Position 23 2)), LineComment "--")
, ((Span (Position 24 1) (Position 24 12)), LineComment "-- *Remark:*")
, ((Span (Position 25 1) (Position 25 54)), LineComment "-- Since there is no special syntax for set functions,")
, ((Span (Position 26 1) (Position 26 58)), LineComment "-- one has to write `(setn f)` for the set function of the")
, ((Span (Position 27 1) (Position 27 34)), LineComment "-- _n-ary top-level function_ `f`.")
, ((Span (Position 28 1) (Position 28 65)), LineComment "-- The correct usage of set functions is currently not checked by")
, ((Span (Position 29 1) (Position 29 57)), LineComment "-- the compiler, i.e., one can also write unintended uses")
, ((Span (Position 30 1) (Position 30 30)), LineComment "-- like `set0 ((+1) (1 ? 2))`.")
, ((Span (Position 31 1) (Position 31 54)), LineComment "-- In order to check the correct use of set functions,")
, ((Span (Position 32 1) (Position 32 38)), LineComment "-- it is recommended to apply the tool")
, ((Span (Position 33 1) (Position 33 64)), LineComment "-- [CurryCheck](https://cpm.curry-lang.org/pkgs/currycheck.html)")
, ((Span (Position 34 1) (Position 34 64)), LineComment "-- on Curry programs which reports illegal uses of set functions")
, ((Span (Position 35 1) (Position 35 28)), LineComment "-- (among other properties).")
, ((Span (Position 36 1) (Position 36 2)), LineComment "--")
, ((Span (Position 37 1) (Position 37 62)), LineComment "-- The set of values returned by a set function is represented")
, ((Span (Position 38 1) (Position 38 63)), LineComment "-- by an abstract type 'Values' on which several operations are")
, ((Span (Position 39 1) (Position 39 64)), LineComment "-- defined in this module. Actually, it is a multiset of values,")
, ((Span (Position 40 1) (Position 40 36)), LineComment "-- i.e., duplicates are not removed.")
, ((Span (Position 41 1) (Position 41 2)), LineComment "--")
, ((Span (Position 42 1) (Position 42 67)), LineComment "-- The handling of failures and nested occurrences of set functions")
, ((Span (Position 43 1) (Position 43 71)), LineComment "-- is not specified in the previous paper. Thus, a detailed description")
, ((Span (Position 44 1) (Position 44 67)), LineComment "-- of the semantics of set functions as implemented in this library")
, ((Span (Position 45 1) (Position 45 28)), LineComment "-- can be found in the paper")
, ((Span (Position 46 1) (Position 46 2)), LineComment "--")
, ((Span (Position 47 1) (Position 47 51)), LineComment "-- > J. Christiansen, M. Hanus, F. Reck, D. Seidel:")
, ((Span (Position 48 1) (Position 48 76)), LineComment "-- > A Semantics for Weakly Encapsulated Search in Functional Logic Programs")
, ((Span (Position 49 1) (Position 49 67)), LineComment "-- > Proc. 15th International Conference on Principles and Practice")
, ((Span (Position 50 1) (Position 50 69)), LineComment "-- > of Declarative Programming (PPDP'13), pp. 49-60, ACM Press, 2013")
, ((Span (Position 51 1) (Position 51 2)), LineComment "--")
, ((Span (Position 52 1) (Position 52 62)), LineComment "-- Note that the implementation of this library uses multisets")
, ((Span (Position 53 1) (Position 53 60)), LineComment "-- instead of sets. Thus, the result of a set function might")
, ((Span (Position 54 1) (Position 54 61)), LineComment "-- contain multiple values. From a declarative point of view,")
, ((Span (Position 55 1) (Position 55 59)), LineComment "-- this is not relevant. It has the advantage that equality")
, ((Span (Position 56 1) (Position 56 64)), LineComment "-- is not required on values, i.e., encapsulated values can also")
, ((Span (Position 57 1) (Position 57 17)), LineComment "-- be functional.")
, ((Span (Position 58 1) (Position 58 2)), LineComment "--")
, ((Span (Position 59 1) (Position 59 70)), LineComment "-- The PAKCS implementation of set functions has several restrictions,")
, ((Span (Position 60 1) (Position 60 17)), LineComment "-- in particular:")
, ((Span (Position 61 1) (Position 61 2)), LineComment "--")
, ((Span (Position 62 1) (Position 62 67)), LineComment "-- 1. The multiset of values is completely evaluated when demanded.")
, ((Span (Position 63 1) (Position 63 64)), LineComment "--    Thus, if it is infinite, its evaluation will not terminate")
, ((Span (Position 64 1) (Position 64 63)), LineComment "--    even if only some elements (e.g., for a containment test)")
, ((Span (Position 65 1) (Position 65 64)), LineComment "--    are demanded. However, for the emptiness test, at most one")
, ((Span (Position 66 1) (Position 66 28)), LineComment "--    value will be computed")
, ((Span (Position 67 1) (Position 67 67)), LineComment "-- 2. The arguments of a set function are strictly evaluated before")
, ((Span (Position 68 1) (Position 68 49)), LineComment "--    the set functions itself will be evaluated.")
, ((Span (Position 69 1) (Position 69 59)), LineComment "-- 3. If the multiset of values contains unbound variables,")
, ((Span (Position 70 1) (Position 70 30)), LineComment "--    the evaluation suspends.")
, ((Span (Position 71 1) (Position 71 2)), LineComment "--")
, ((Span (Position 72 1) (Position 72 38)), LineComment "-- Author : Michael Hanus, Fabian Reck")
, ((Span (Position 73 1) (Position 73 24)), LineComment "-- Version: October 2026")
, ((Span (Position 74 1) (Position 74 72)), LineComment "------------------------------------------------------------------------")
, ((Span (Position 98 1) (Position 98 72)), LineComment "------------------------------------------------------------------------")
, ((Span (Position 99 1) (Position 99 80)), LineComment "-- | Combinator to transform a 0-ary function into a corresponding set function.")
, ((Span (Position 112 1) (Position 112 80)), LineComment "-- | Combinator to transform a unary function into a corresponding set function.")
, ((Span (Position 125 1) (Position 125 81)), LineComment "-- | Combinator to transform a binary function into a corresponding set function.")
, ((Span (Position 140 1) (Position 140 50)), LineComment "-- | Combinator to transform a function of arity 3")
, ((Span (Position 141 1) (Position 141 39)), LineComment "--   into a corresponding set function.")
, ((Span (Position 157 1) (Position 157 50)), LineComment "-- | Combinator to transform a function of arity 4")
, ((Span (Position 158 1) (Position 158 39)), LineComment "--   into a corresponding set function.")
, ((Span (Position 175 1) (Position 175 50)), LineComment "-- | Combinator to transform a function of arity 5")
, ((Span (Position 176 1) (Position 176 39)), LineComment "--   into a corresponding set function.")
, ((Span (Position 194 1) (Position 194 50)), LineComment "-- | Combinator to transform a function of arity 6")
, ((Span (Position 195 1) (Position 195 39)), LineComment "--   into a corresponding set function.")
, ((Span (Position 215 1) (Position 215 50)), LineComment "-- | Combinator to transform a function of arity 7")
, ((Span (Position 216 1) (Position 216 39)), LineComment "--   into a corresponding set function.")
, ((Span (Position 236 1) (Position 236 72)), LineComment "------------------------------------------------------------------------")
, ((Span (Position 237 1) (Position 237 15)), LineComment "-- Auxiliaries:")
, ((Span (Position 253 1) (Position 253 66)), LineComment "-- Returns `True` after evaluating the argument to a ground value.")
, ((Span (Position 259 1) (Position 259 72)), LineComment "------------------------------------------------------------------------")
, ((Span (Position 260 1) (Position 260 52)), LineComment "-- | Abstract type representing multisets of values.")
, ((Span (Position 265 1) (Position 265 67)), LineComment "-- In PAKCS, values are represented as lists but the first argument")
, ((Span (Position 266 1) (Position 266 63)), LineComment "-- is used if values are tested for emptiness of a single value")
, ((Span (Position 267 1) (Position 267 70)), LineComment "-- is selected. This has the advantage that one can deal with infinite")
, ((Span (Position 268 1) (Position 268 66)), LineComment "-- search spaces as long as one is only interested in an emptiness")
, ((Span (Position 269 1) (Position 269 26)), LineComment "-- test or a single value.")
, ((Span (Position 273 1) (Position 273 72)), LineComment "-- | Internal operation to extract all elements of a multiset of values.")
, ((Span (Position 281 1) (Position 281 70)), LineComment "----------------------------------------------------------------------")
, ((Span (Position 283 1) (Position 283 35)), LineComment "-- | Is a multiset of values empty?")
, ((Span (Position 292 1) (Position 292 39)), LineComment "-- | Is a multiset of values not empty?")
, ((Span (Position 296 1) (Position 296 54)), LineComment "-- | Is some value an element of a multiset of values?")
, ((Span (Position 300 1) (Position 300 71)), LineComment "-- | Chooses (non-deterministically) some value in a multiset of values")
, ((Span (Position 301 1) (Position 301 63)), LineComment "--   and returns the chosen value. For instance, the expression")
, ((Span (Position 302 1) (Position 302 2)), LineComment "--")
, ((Span (Position 303 1) (Position 303 41)), LineComment "--       chooseValue (set1 anyOf [1,2,3])")
, ((Span (Position 304 1) (Position 304 2)), LineComment "--")
, ((Span (Position 305 1) (Position 305 69)), LineComment "--   non-deterministically evaluates to the values `1`, `2`, and `3`.")
, ((Span (Position 307 1) (Position 307 68)), LineComment "--   Thus, `(set1 chooseValue)` is the identity on value sets, i.e.,")
, ((Span (Position 308 1) (Position 308 61)), LineComment "--   `(set1 chooseValue s)` contains the same elements as the")
, ((Span (Position 309 1) (Position 309 19)), LineComment "--   value set `s`.")
, ((Span (Position 313 1) (Position 313 71)), LineComment "-- | Chooses (non-deterministically) some value in a multiset of values")
, ((Span (Position 314 1) (Position 314 71)), LineComment "--   and returns the chosen value and the remaining multiset of values.")
, ((Span (Position 315 1) (Position 315 64)), LineComment "--   Thus, if we consider the operation `chooseValue` defined by")
, ((Span (Position 316 1) (Position 316 2)), LineComment "--")
, ((Span (Position 317 1) (Position 317 39)), LineComment "--       chooseValue x = fst (choose x)")
, ((Span (Position 318 1) (Position 318 2)), LineComment "--")
, ((Span (Position 319 1) (Position 319 67)), LineComment "--   then `(set1 chooseValue)` is the identity on value sets, i.e.,")
, ((Span (Position 320 1) (Position 320 61)), LineComment "--   `(set1 chooseValue s)` contains the same elements as the")
, ((Span (Position 321 1) (Position 321 19)), LineComment "--   value set `s`.")
, ((Span (Position 332 1) (Position 332 69)), LineComment "-- | Selects (indeterministically) some value in a multiset of values")
, ((Span (Position 333 1) (Position 333 36)), LineComment "--   and returns the selected value.")
, ((Span (Position 334 1) (Position 334 66)), LineComment "--   Thus, `selectValue` has always at most one value, i.e., it is")
, ((Span (Position 335 1) (Position 335 31)), LineComment "--   a deterministic operation.")
, ((Span (Position 336 1) (Position 336 40)), LineComment "--   It fails if the value set is empty.")
, ((Span (Position 337 1) (Position 337 2)), LineComment "--")
, ((Span (Position 338 1) (Position 338 14)), LineComment "--   **NOTE:**")
, ((Span (Position 339 1) (Position 339 69)), LineComment "--   The usage of this operation is only safe (i.e., does not destroy")
, ((Span (Position 340 1) (Position 340 67)), LineComment "--   completeness) if all values in the argument set are identical.")
, ((Span (Position 348 1) (Position 348 69)), LineComment "-- | Selects (indeterministically) some value in a multiset of values")
, ((Span (Position 349 1) (Position 349 73)), LineComment "--   and returns the selected value and the remaining multiset of values.")
, ((Span (Position 350 1) (Position 350 61)), LineComment "--   Thus, `select` has always at most one value, i.e., it is")
, ((Span (Position 351 1) (Position 351 31)), LineComment "--   a deterministic operation.")
, ((Span (Position 352 1) (Position 352 40)), LineComment "--   It fails if the value set is empty.")
, ((Span (Position 353 1) (Position 353 2)), LineComment "--")
, ((Span (Position 354 1) (Position 354 14)), LineComment "--   **NOTE:**")
, ((Span (Position 355 1) (Position 355 69)), LineComment "--   The usage of this operation is only safe (i.e., does not destroy")
, ((Span (Position 356 1) (Position 356 67)), LineComment "--   completeness) if all values in the argument set are identical.")
, ((Span (Position 365 1) (Position 365 70)), LineComment "-- | Returns (indeterministically) some value in a multiset of values.")
, ((Span (Position 366 1) (Position 366 54)), LineComment "--   If the value set is empty, `Nothing` is returned.")
, ((Span (Position 375 1) (Position 375 69)), LineComment "-- | Selects (indeterministically) some value in a multiset of values")
, ((Span (Position 376 1) (Position 376 73)), LineComment "--   and returns the selected value and the remaining multiset of values.")
, ((Span (Position 377 1) (Position 377 49)), LineComment "--   Thus, `select` has always at most one value.")
, ((Span (Position 378 1) (Position 378 54)), LineComment "--   If the value set is empty, `Nothing` is returned.")
, ((Span (Position 389 1) (Position 389 61)), LineComment "-- | Maps a function to all elements of a multiset of values.")
, ((Span (Position 397 1) (Position 397 74)), LineComment "-- | Accumulates all elements of a multiset of values by applying a binary")
, ((Span (Position 398 1) (Position 398 76)), LineComment "--   operation. This is similarly to fold on lists, but the binary operation")
, ((Span (Position 399 1) (Position 399 75)), LineComment "--   must be **commutative** so that the result is independent of the order")
, ((Span (Position 400 1) (Position 400 64)), LineComment "--   of applying this operation to all elements in the multiset.")
, ((Span (Position 404 1) (Position 404 73)), LineComment "-- | Keeps all elements of a multiset of values that satisfy a predicate.")
, ((Span (Position 415 1) (Position 415 58)), LineComment "-- | Returns the minimum of a non-empty multiset of values")
, ((Span (Position 416 1) (Position 416 64)), LineComment "--   according to the given comparison function on the elements.")
, ((Span (Position 420 1) (Position 420 58)), LineComment "-- | Returns the minimum of a non-empty multiset of values")
, ((Span (Position 421 1) (Position 421 64)), LineComment "--   according to the given comparison function on the elements.")
, ((Span (Position 425 1) (Position 425 58)), LineComment "-- | Returns the maximum of a non-empty multiset of values")
, ((Span (Position 426 1) (Position 426 64)), LineComment "--   according to the given comparison function on the elements.")
, ((Span (Position 430 1) (Position 430 58)), LineComment "-- | Returns the maximum of a non-empty multiset of values")
, ((Span (Position 431 1) (Position 431 64)), LineComment "--   according to the given comparison function on the elements.")
, ((Span (Position 435 1) (Position 435 57)), LineComment "-- | Puts all elements of a multiset of values in a list.")
, ((Span (Position 436 1) (Position 436 64)), LineComment "--   Since the order of the elements in the list might depend on")
, ((Span (Position 437 1) (Position 437 66)), LineComment "--   the time of the computation, this operation is an I/O action.")
, ((Span (Position 441 1) (Position 441 49)), LineComment "-- | Prints all elements of a multiset of values.")
, ((Span (Position 445 1) (Position 445 58)), LineComment "-- | Transforms a multiset of values into a list sorted by")
, ((Span (Position 446 1) (Position 446 73)), LineComment "--   the standard term ordering. As a consequence, the multiset of values")
, ((Span (Position 447 1) (Position 447 29)), LineComment "--   is completely evaluated.")
, ((Span (Position 451 1) (Position 451 75)), LineComment "-- | Transforms a multiset of values into a list sorted by a given ordering")
, ((Span (Position 452 1) (Position 452 60)), LineComment "--   on the values. As a consequence, the multiset of values")
, ((Span (Position 453 1) (Position 453 29)), LineComment "--   is completely evaluated.")
, ((Span (Position 454 1) (Position 454 79)), LineComment "--   In order to ensure that the result of this operation is independent of the")
, ((Span (Position 455 1) (Position 455 64)), LineComment "--   evaluation order, the given ordering must be a total order.")
, ((Span (Position 459 1) (Position 459 72)), LineComment "------------------------------------------------------------------------")
]
