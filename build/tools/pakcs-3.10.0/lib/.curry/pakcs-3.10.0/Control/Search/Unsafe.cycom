[ ((Span (Position 1 1) (Position 1 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 2 1) (Position 2 74)), LineComment "-- | Library with operations to encapsulate search, i.e., to return all or")
, ((Span (Position 3 1) (Position 3 73)), LineComment "-- some values of an expression containing non-deterministic computations")
, ((Span (Position 4 1) (Position 4 23)), LineComment "-- in a data structure.")
, ((Span (Position 5 1) (Position 5 62)), LineComment "-- Note that these operations are not fully declarative, i.e.,")
, ((Span (Position 6 1) (Position 6 67)), LineComment "-- the results depend on the order of evaluation and program rules.")
, ((Span (Position 7 1) (Position 7 67)), LineComment "-- This is due to the fact that the search operators work on a copy")
, ((Span (Position 8 1) (Position 8 48)), LineComment "-- of the current expression to be encapsulated.")
, ((Span (Position 9 1) (Position 9 69)), LineComment "-- The potential problems of this method are discussed in this paper:")
, ((Span (Position 10 1) (Position 10 2)), LineComment "--")
, ((Span (Position 11 1) (Position 11 35)), LineComment "-- > B. Brassel, M. Hanus, F. Huch:")
, ((Span (Position 12 1) (Position 12 67)), LineComment "-- > Encapsulating Non-Determinism in Functional Logic Computations")
, ((Span (Position 13 1) (Position 13 68)), LineComment "-- > Journal of Functional and Logic Programming, No. 6, EAPLS, 2004")
, ((Span (Position 14 1) (Position 14 2)), LineComment "--")
, ((Span (Position 15 1) (Position 15 64)), LineComment "-- There are newer and better approaches the encapsulate search,")
, ((Span (Position 16 1) (Position 16 74)), LineComment "-- in particular, set functions (see module `Control.Search.SetFunctions`)")
, ((Span (Position 17 1) (Position 17 24)), LineComment "-- which should be used.")
, ((Span (Position 18 1) (Position 18 2)), LineComment "--")
, ((Span (Position 19 1) (Position 19 25)), LineComment "-- Author : Michael Hanus")
, ((Span (Position 20 1) (Position 20 24)), LineComment "-- Version: October 2026")
, ((Span (Position 21 1) (Position 21 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 33 1) (Position 33 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 35 1) (Position 35 41)), LineComment "-- | Returns all values of an expression.")
, ((Span (Position 36 1) (Position 36 67)), LineComment "-- Conceptually, the value is computed on a copy of the expression,")
, ((Span (Position 37 1) (Position 37 69)), LineComment "-- i.e., the evaluation of the expression does not share any results.")
, ((Span (Position 38 1) (Position 38 2)), LineComment "--")
, ((Span (Position 39 1) (Position 39 69)), LineComment "-- The strategy to search for all values depends on the Curry system:")
, ((Span (Position 40 1) (Position 40 2)), LineComment "--")
, ((Span (Position 41 1) (Position 41 78)), LineComment "-- * PAKCS uses a depth-first search strategy and computes all values at once,")
, ((Span (Position 42 1) (Position 42 79)), LineComment "-- * KiCS2 uses a breadth-first search strategy and computes all values lazily.")
, ((Span (Position 43 1) (Position 43 73)), LineComment "-- * Curry2Go uses a fair search strategy and computes all values lazily.")
, ((Span (Position 44 1) (Position 44 2)), LineComment "--")
, ((Span (Position 45 1) (Position 45 62)), LineComment "-- In PAKCS, the evaluation suspends as long as the expression")
, ((Span (Position 46 1) (Position 46 51)), LineComment "-- or its computed value contain unbound variables.")
, ((Span (Position 47 1) (Position 47 2)), LineComment "--")
, ((Span (Position 48 1) (Position 48 72)), LineComment "-- Note that this operation is not purely declarative since the ordering")
, ((Span (Position 49 1) (Position 49 71)), LineComment "-- of the computed values depends on the ordering of the program rules.")
, ((Span (Position 57 1) (Position 57 41)), LineComment "-- | Returns all values of an expression.")
, ((Span (Position 58 1) (Position 58 73)), LineComment "-- This operation is similar to 'allValues' but uses a depth-first search")
, ((Span (Position 59 1) (Position 59 27)), LineComment "-- strategy (if available).")
, ((Span (Position 60 1) (Position 60 65)), LineComment "-- Thus, it could be more efficient than 'allValues' but it might")
, ((Span (Position 61 1) (Position 61 73)), LineComment "-- not terminate (instead of computing of all values) if the search space")
, ((Span (Position 62 1) (Position 62 15)), LineComment "-- is infinite.")
, ((Span (Position 67 31) (Position 67 71)), LineComment "-- PAKCS supports only depth-first search")
, ((Span (Position 74 1) (Position 74 58)), LineComment "-- | Returns just one value for an expression or `Nothing`")
, ((Span (Position 75 1) (Position 75 34)), LineComment "-- if the expression has no value.")
, ((Span (Position 76 1) (Position 76 67)), LineComment "-- Conceptually, the value is computed on a copy of the expression,")
, ((Span (Position 77 1) (Position 77 69)), LineComment "-- i.e., the evaluation of the expression does not share any results.")
, ((Span (Position 78 1) (Position 78 2)), LineComment "--")
, ((Span (Position 79 1) (Position 79 66)), LineComment "-- The strategy to search for a value depends on the Curry system:")
, ((Span (Position 80 1) (Position 80 2)), LineComment "--")
, ((Span (Position 81 1) (Position 81 46)), LineComment "-- * PAKCS uses a depth-first search strategy,")
, ((Span (Position 82 1) (Position 82 52)), LineComment "-- * KiCS2 uses a breadth-first search strategy, and")
, ((Span (Position 83 1) (Position 83 42)), LineComment "-- * Curry2Go uses a fair search strategy.")
, ((Span (Position 84 1) (Position 84 2)), LineComment "--")
, ((Span (Position 85 1) (Position 85 62)), LineComment "-- In PAKCS, the evaluation suspends as long as the expression")
, ((Span (Position 86 1) (Position 86 51)), LineComment "-- or its computed value contain unbound variables.")
, ((Span (Position 87 1) (Position 87 2)), LineComment "--")
, ((Span (Position 88 1) (Position 88 59)), LineComment "-- Note that this operation is not purely declarative since")
, ((Span (Position 89 1) (Position 89 67)), LineComment "-- the computed value depends on the ordering of the program rules.")
, ((Span (Position 90 1) (Position 90 61)), LineComment "-- Thus, this operation should be used only if the expression")
, ((Span (Position 91 1) (Position 91 25)), LineComment "-- has at most one value.")
, ((Span (Position 101 1) (Position 101 58)), LineComment "-- | Returns just one value for an expression or `Nothing`")
, ((Span (Position 102 1) (Position 102 34)), LineComment "-- if the expression has no value.")
, ((Span (Position 103 1) (Position 103 72)), LineComment "-- This operation is similar to 'oneValue' but uses a depth-first search")
, ((Span (Position 104 1) (Position 104 27)), LineComment "-- strategy (if available).")
, ((Span (Position 105 1) (Position 105 78)), LineComment "-- Thus, it could be more efficient than 'oneValue' but it might not terminate")
, ((Span (Position 106 1) (Position 106 67)), LineComment "-- (instead of computing of value) if the search space is infinite.")
, ((Span (Position 113 29) (Position 113 69)), LineComment "-- PAKCS supports only depth-first search")
, ((Span (Position 122 1) (Position 122 42)), LineComment "-- | Returns some value for an expression.")
, ((Span (Position 123 1) (Position 123 57)), LineComment "-- If the expression has no value, the computation fails.")
, ((Span (Position 124 1) (Position 124 67)), LineComment "-- Conceptually, the value is computed on a copy of the expression,")
, ((Span (Position 125 1) (Position 125 69)), LineComment "-- i.e., the evaluation of the expression does not share any results.")
, ((Span (Position 126 1) (Position 126 2)), LineComment "--")
, ((Span (Position 127 1) (Position 127 62)), LineComment "-- In PAKCS, the evaluation suspends as long as the expression")
, ((Span (Position 128 1) (Position 128 51)), LineComment "-- or its computed value contain unbound variables.")
, ((Span (Position 129 1) (Position 129 2)), LineComment "--")
, ((Span (Position 130 1) (Position 130 59)), LineComment "-- Note that this operation is not purely declarative since")
, ((Span (Position 131 1) (Position 131 67)), LineComment "-- the computed value depends on the ordering of the program rules.")
, ((Span (Position 132 1) (Position 132 61)), LineComment "-- Thus, this operation should be used only if the expression")
, ((Span (Position 133 1) (Position 133 22)), LineComment "-- has a single value.")
, ((Span (Position 138 1) (Position 138 58)), LineComment "-- | Does the computation of the argument to a value fail?")
, ((Span (Position 139 1) (Position 139 56)), LineComment "-- Thus, `isFail e` returns `True` if the expression `e`")
, ((Span (Position 140 1) (Position 140 70)), LineComment "-- has no value. For instance, `isFail (head [])` evaluates to `True`.")
, ((Span (Position 141 1) (Position 141 2)), LineComment "--")
, ((Span (Position 142 1) (Position 142 59)), LineComment "-- Conceptually, the argument is evaluated on a copy, i.e.,")
, ((Span (Position 143 1) (Position 143 68)), LineComment "-- even if the computation does not fail, it has not been evaluated.")
, ((Span (Position 148 1) (Position 148 78)), LineComment "------------------------------------------------------------------------------")
, ((Span (Position 149 1) (Position 149 50)), LineComment "-- | Gets all values computable by term rewriting.")
, ((Span (Position 150 1) (Position 150 59)), LineComment "-- In contrast to `allValues`, this operation does not wait")
, ((Span (Position 151 1) (Position 151 53)), LineComment "-- until all \"outside\" variables are bound to values,")
, ((Span (Position 152 1) (Position 152 57)), LineComment "-- but it returns all values computable by term rewriting")
, ((Span (Position 153 1) (Position 153 77)), LineComment "-- and ignores all computations that requires bindings for outside variables.")
, ((Span (Position 161 1) (Position 161 69)), LineComment "-- | Similarly to 'rewriteAll' but returns only some value computable")
, ((Span (Position 162 1) (Position 162 66)), LineComment "-- by term rewriting. Returns `Nothing` if there is no such value.")
, ((Span (Position 170 1) (Position 170 78)), LineComment "------------------------------------------------------------------------------")
